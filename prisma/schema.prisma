// JobFlex Prisma schema — SQLite for local dev. Vercel builds swap this
// datasource block to Neon Postgres via scripts/prisma-production-schema.js
// (see vercel.json). Keep this block SQLite: flipping it to postgresql breaks
// `prisma generate` locally (postinstall + build) and every runtime query,
// because .env.local points DATABASE_URL at file:./dev.db.
// Enums moved to src/lib/prismaEnums.ts; string[] stored as JSON-encoded strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tenancy + Auth
// ─────────────────────────────────────────────

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?
  primaryColor          String?
  billingEmail          String?
  phone                 String?
  address               String?
  website               String?
  timezone              String    @default("America/New_York")
  // Text messages (2026-09-24): client-facing texts on/off (the proposal link
  // when sent, a reminder the day before a visit), and the company's own
  // number when it claimed one (provisioned into the platform's Messaging
  // Service, so it stays registered; released from Settings or /admin).
  smsClientsOn          Boolean   @default(true)
  smsFromNumber         String?
  smsNumberSid          String?
  // Online booking (2026-09-23): hours, slot length, lead time, crews, the services offered.
  bookingSettingsJson   String?
  defaultTaxRate        Float     @default(0)
  // Org-wide default profit markup (hidden from the client). Seeded into a new
  // proposal's per-proposal materialMarkupPct/laborMarkupPct at creation; the
  // contractor can override per proposal. @default(0) = existing orgs keep 0%
  // (current behaviour — no price change), so no backfill is needed.
  materialMarkupPct     Float     @default(0)
  laborMarkupPct        Float     @default(0)
  aiPromptCustom        String?
  publicProfileEnabled  Boolean   @default(false)
  landingHeroTitle      String?
  landingHeroSubtitle   String?
  heroImageUrl          String?
  servicesJson          String?
  // Settings persistence — one JSON-as-String blob per settings page (hydrated whole on load).
  paymentSettingsJson   String? // settings/payment  {stripe,square,paypal,ach,currency,depositPct,netTerms,lateFeePct,autoRemind,lateFees}
  leadsSettingsJson     String? // settings/leads     {strategy,zips[],travelRadius,maxPerDay,maxPerRep,aiCategorize,instantSms,businessHours}
  gmailSettingsJson     String? // settings/gmail     {sendFromUser,trackOpens,autoSync,displayName,replyTo,signature}
  gmailTokensJson       String? // OAuth secrets      {accessToken,refreshToken,expiryDate,email} — set by the Gmail connect callback
  metaSettingsJson      String? // settings/meta      {connected,autoCreate,autoText,defaultPage,formCategory}
  proposalSettingsJson  String? // settings/proposals {validityDays,markups{...},schedule[],terms,requireSig,autoFollowUp}
  projectSettingsJson   String? // Projects → Automatic projects (2026-11-05) {auto,trades[]} — lib/projectStages/shared parseProjectSettings
  // THE JOBFLEX NETWORK (2026-11-08, the subcontractors plan, part 3; lib/subFinder): the company's opt-in to be found
  // by other JobFlex companies as a sub — {on, trades[], serviceAreas, contact{name,phone,email}, since}.
  networkJson           String?
  // Lead Center matching profile — canonical TRADE_TYPES multi-select (JSON string[],
  // closed vocabulary from src/lib/tradeTypes.ts; distinct from the free-text Specialty
  // model which steers AI estimator prompts). lat/lng geocoded from `address` at
  // register/profile-save; orgs without coords are ineligible for platform lead offers.
  tradeTypesJson        String?   @default("[]")
  // Free text typed under the register form's "Other" trade chip. Deliberately
  // NOT folded into tradeTypesJson: that column is validated against the closed
  // TRADE_TYPES vocabulary (src/lib/tradeTypes.ts) and anything unrecognised is
  // dropped on read, so a custom trade needs a column of its own to survive.
  otherTrade            String?
  lat                   Float?
  lng                   Float?
  geocodedAt            DateTime?
  leadOffersEnabled     Boolean   @default(true)
  // How far from the shop a homeowner's job may be for the Lead Center to
  // offer it (2026-10-03): the cascade and the admin's hand-send list keep to
  // it, measured lead pin → shop pin. The shop sets it on the Company page.
  serviceRadiusMiles    Int       @default(50)
  // JobFlex's own organizations (QA Co, the owner's): the only ones a TEST
  // platform lead may be sent to. Flipped in the admin Lead Center.
  isInternal            Boolean   @default(false)
  // Pre-signup attribution stamp (first-write-wins: set once at account creation,
  // never overwritten). The money record stays Stripe-truth (Attribution model);
  // this is captured intent used for the signup pill + checkout auto-apply.
  signupPromoCode       String?
  signupPromoCodeId     String?
  attributionCapturedAt DateTime?
  // Where the signup CAME FROM (CRO stage 1, 2026-09-09): the trade hero the
  // visitor landed on (`?industry=` on the landing, a TRADE_TYPES value) and
  // the visit's utm_* — copied from the pending signup record when the
  // organization is created, first-write-wins, never overwritten. Advisory:
  // tradeTypesJson is what the owner chose; this is what the ad promised.
  landingIndustry       String?
  // landing-e's test variant ("e"), null for every other signup (pass A,
  // 2026-09-11). Read by the Overview's first-run card and Admin → Traffic.
  signupVariant         String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  // What the signup remembered for Meta's Conversions API: consent, fbp/fbc,
  // IP and UA, the browser's event ids. JSON. No longer written since the
  // Conversions API was removed (2026-10-17); kept for the rows that have it.
  metaSignupJson        String?
  // Soft delete (Settings → Danger zone). A deleted org is invisible to
  // requireOrg() and every public surface at once; the purge cron hard-deletes
  // (cascade) 30 days later. deletedById = the owner who confirmed.
  deletedAt             DateTime?
  deletedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships            Membership[]
  paymentConnections     PaymentConnection[]
  invites                Invite[]
  clients                Client[]
  clientFacts            ClientFact[]
  clientPromises         ClientPromise[]
  clientBriefs           ClientBrief[]
  clientMerges           ClientMerge[]
  clientThreads          ClientThread[]
  clientMessages         ClientMessage[]
  leads                  Lead[]
  proposals              Proposal[]
  templates              ProposalTemplate[]
  jobs                   Job[]
  jobEvents              JobEvent[]
  workDays               WorkDay[]
  workerProfiles         WorkerProfile[]
  payments               Payment[]
  invoices               Invoice[]
  activities             ActivityEvent[]
  conversations          Conversation[]
  announcements          Announcement[]
  emailTemplates         EmailTemplate[]
  followUpRules          FollowUpRule[]
  followUps              FollowUp[]
  aiDrafts               AiDraft[]
  aiPromptPacks          AiPromptPack[]
  aiEstimates            AiEstimate[]
  tags                   Tag[]
  subscription           Subscription?
  supportTickets         SupportTicket[]
  specialties            Specialty[]
  homeownerReqs          HomeownerRequest[]
  leadOffers             LeadOffer[]
  changeOrders           ChangeOrder[]
  reviewRequests         ReviewRequest[]
  referralCodes          ReferralCode[]
  tradePosts             TradePost[]
  phoneCalls             AiPhoneCall[]
  notificationPhones     NotificationPhone[]
  appointments           Appointment[]
  blockedTimes           BlockedTime[]
  unavailabilityRules    UnavailabilityRule[]
  projects               Project[]
  applicants             Applicant[]
  influencerPayouts      InfluencerPayout[]
  influencerStatements   InfluencerStatement[]
  eagleViewReports       EagleViewReport[]
  roofMeasurements       RoofMeasurement[]
  overheads              MonthlyOverhead[]
  suppliers              Supplier[]
  inventoryItems         InventoryItem[]
  servicePlanTemplates   ServicePlanTemplate[]
  servicePlans           ServicePlan[]
  servicePlanVisits      ServicePlanVisit[]
  clientEquipment        ClientEquipment[]
  visitReports           VisitReport[]
  bookings               Booking[]
  // Why a plan was cancelled, and asks for more trial days (2026-10-20).
  cancellationFeedback   CancellationFeedback[]
  trialExtensionRequests TrialExtensionRequest[]
  // Every declined plan charge, for /admin/revenue/failed-payments (2026-10-21).
  paymentFailures        PaymentFailure[]
  // The JobFlex Assistant's phones, turns and proposed changes (2026-11-04).
  assistantLinks         AssistantLink[]
  assistantMessages      AssistantMessage[]
  assistantActions       AssistantAction[]
  contractors            Contractor[]
  subRequests            SubRequest[]
  subDocuments           SubDocument[]
  inboundEmails          InboundEmail[]
  signupPromo            PromoCode?              @relation("OrgSignupPromo", fields: [signupPromoCodeId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([signupPromoCodeId])
  @@index([deletedAt])
}

// One month's recurring business cost sheet — the costs that exist whether or
// not a single job runs. Keyed by calendar month (year + month 1-12) rather
// than a DateTime so the record IS the month, with no timezone to get wrong.
//
// Eight fixed categories, plus three that scale: workers / sales / marketing
// are entered either as flat dollars or as a percent of that month's revenue,
// chosen by the matching *Pct flag. The dollars-vs-percent split is what lets
// the Overhead tab report a fixed total and a variable total separately.
model MonthlyOverhead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int

  // FIXED — flat dollars, unmoved by revenue.
  rent      Float @default(0)
  office    Float @default(0)
  insurance Float @default(0)
  vehicles  Float @default(0)
  software  Float @default(0)
  warehouse Float @default(0)
  utilities Float @default(0)
  other     Float @default(0)

  // SCALING — amount is dollars when the flag is false, a percent of the
  // month's revenue when it is true.
  workers      Float   @default(0)
  workersPct   Boolean @default(false)
  sales        Float   @default(0)
  salesPct     Boolean @default(false)
  marketing    Float   @default(0)
  marketingPct Boolean @default(false)

  // The contractor's own fixed lines beyond the eight above — a yard lease, a
  // bookkeeper, a storage unit. JSON-as-String: [{ "id", "label", "amount" }].
  // Fixed only: a custom line never scales with revenue.
  customJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

// Cached EagleView roof-measurement reports. A report is a billable order, so we
// fetch + parse it once and reuse the result. modelJson holds the parsed
// RoofModel geometry (points/lines/faces); summaryJson the raw GetReport header.
model EagleViewReport {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId         Int
  status           String       @default("In Process")
  statusId         Int?
  address          String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  productId        Int?
  totalCost        Float?
  // Headline measurements (parsed from geometry; mirror EagleView's summary).
  areaSqft         Float?
  squares          Float?
  predominantPitch String?
  facetCount       Int?
  // JSON-as-String (SQLite): parsed RoofModel geometry + raw GetReport summary.
  modelJson        String?
  summaryJson      String?
  orderedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, reportId])
  @@index([organizationId])
}

// Saved roof measurements from the Instant flow: EagleView Property Data
// (numbers, outline, flags, imagery) merged with the aerial reconstruction
// (facet geometry) and calibrated to it. Instant results carry a UUID rather
// than a reportId and every lookup is billed, so the merged result is persisted
// once here and re-opened from history, the proposal and the handheld page.
model RoofMeasurement {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String?
  // instant+recon | instant-outline | recon
  source           String
  address          String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  // Headline figures (Instant's when present, else the reconstruction's).
  areaSqft         Float?
  squares          Float?
  predominantPitch String?
  facetCount       Int?
  instantRequestId String?
  // JSON-as-String (SQLite): Instant summary, calibrated RoofModel, chimney
  // candidates, calibration report + imagery provenance.
  instantJson      String?
  modelJson        String
  chimneyJson      String?
  provenanceJson   String?
  // Exported drawing (Vercel Blob), filled by the export batch.
  pngUrl           String?
  pdfUrl           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  image                 String?
  hashedPassword        String?
  emailVerified         DateTime?
  locale                String?
  // Contact + preferences owned by the PERSON, not the org: the settings
  // Profile card's phone, and the notification matrix (channel toggles per
  // event, quiet hours, digest time) as one JSON-as-String blob, hydrated whole
  // like the org's *SettingsJson columns.
  phone                 String?
  // Text messages (2026-09-24): the mobile the office events are texted to,
  // verified by a six-digit code — the code is also the consent. Null: no texts.
  smsPhone              String?
  smsVerifiedAt         DateTime?
  notificationPrefsJson String?
  // Platform-admin authority for the (admin) console. Distinct from the
  // org-level Membership.role — only flagged users may reach platform-wide
  // money/influencer pages. Tightens the old "any OWNER/ADMIN of any org" gate.
  isPlatformAdmin       Boolean   @default(false)
  // Credential epoch for stateless-JWT session revocation. Stamped into the JWT
  // at sign-in and re-checked on every guarded request (requireUser); bumped on
  // password reset so all previously-issued tokens are invalidated at once —
  // the "log out everywhere" that a bare JWT strategy otherwise can't do.
  credentialVersion     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  activeOrgId           String?

  accounts                 Account[]
  influencer               Influencer?
  supportTickets           SupportTicket[]
  supportMessages          SupportMessage[]
  sessions                 Session[]
  memberships              Membership[]
  workerProfile            WorkerProfile?
  assignedLeads            Lead[]                    @relation("LeadAssignee")
  claimedLeads             Lead[]                    @relation("LeadClaimer")
  proposals                Proposal[]                @relation("ProposalOwner")
  activities               ActivityEvent[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  sentInvites              Invite[]                  @relation("InviteSender")
  referralCodes            ReferralCode[]
  tradePosts               TradePost[]
  tradeReplies             TradeReply[]
  blockedTimes             BlockedTime[]
  unavailabilityRules      UnavailabilityRule[]
  appointmentsCreated      Appointment[]             @relation("AppointmentCreator")
  jobEventsCreated         JobEvent[]                @relation("JobEventCreator")
  phoneVerifications       PhoneVerification[]

  // Trade & Services (contractor-to-contractor job network)
  tradeNetworkProfile  TradeNetworkProfile?
  tradeJobsAuthored    TradeJob[]             @relation("TradeJobAuthor")
  tradeJobRecipients   TradeJobRecipient[]    @relation("TradeJobRecipientUser")
  tradeJobConvAuthored TradeJobConversation[] @relation("TradeJobConvAuthor")
  tradeJobConvReceived TradeJobConversation[] @relation("TradeJobConvRecipient")
  tradeJobMessages     TradeJobMessage[]      @relation("TradeJobMessageAuthor")

  // Admin task tracker (/admin/tasks, 2026-10-11) — back-relations only.
  adminTasksAssigned    AdminTask[]        @relation("AdminTaskAssignee")
  adminTasksAuthored    AdminTask[]        @relation("AdminTaskAuthor")
  adminSubtasksAssigned AdminTaskSubtask[] @relation("AdminSubtaskAssignee")
  adminTaskComments     AdminTaskComment[] @relation("AdminTaskCommentAuthor")
  adminTaskEvents       AdminTaskEvent[]   @relation("AdminTaskEventActor")

  // The cancel window's reasons and the trial-extension asks (2026-10-20) — back-relations only.
  cancellationFeedback   CancellationFeedback[]
  trialExtensionRequests TrialExtensionRequest[] @relation("TrialExtensionRequester")
  trialExtensionsDecided TrialExtensionRequest[] @relation("TrialExtensionDecider")

  // The JobFlex Assistant (2026-11-04) — back-relations only.
  assistantLinks    AssistantLink[]
  assistantMessages AssistantMessage[]
  assistantActions  AssistantAction[]
  clientPromises    ClientPromise[]
  clientThreads     ClientThread[]
  clientMessages    ClientMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  scope             String?
  token_type        String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("USER")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String    @default("USER")
  token          String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// ─────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────

model Client {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  customFields   String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals      Proposal[]
  jobs           Job[]
  projects       Project[]
  activities     ActivityEvent[]
  tags           ClientTag[]
  payments       Payment[]
  reviewRequests ReviewRequest[]
  appointments   Appointment[]
  servicePlans   ServicePlan[]
  equipment      ClientEquipment[]
  visitReports   VisitReport[]
  bookings       Booking[]
  facts          ClientFact[]
  promises       ClientPromise[]
  brief          ClientBrief?
  threads        ClientThread[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

// THE CLIENT'S MEMORY (Smart CRM part 1, 2026-11-08 — the plan doc: structured, source-linked facts; a
// contradiction is flagged and the newer choice wins while the old one stays). One row per remembered fact.
// `status` CURRENT | SUPERSEDED (an older choice the newer one replaced) | RETRACTED (a person removed it).
// `sourceKind` says where it came from — CALL | EMAIL | SMS | NOTE | VISIT | LEAD | PORTAL | PERSON (typed by
// hand) — and sourceId points into that table, so every line can show its original.
model ClientFact {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  category       String // CONTACT | PROJECT | DECISION | COMMITMENT | MONEY | PREFERENCE | HOUSE
  fact           String
  status         String    @default("CURRENT")
  supersededById String?
  sourceKind     String?
  sourceId       String?
  sourceAt       DateTime?
  byAi           Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId, status])
}

// A PROMISE EITHER SIDE MADE (part 1 keeps them; part 4's tracker finds them in messages and closes them when
// the promised thing verifiably happened). `direction` OURS (we owe the client) | THEIRS (the client owes us,
// e.g. "will pay Friday"). `status` OPEN | KEPT | MISSED | CANCELED.
model ClientPromise {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  direction      String    @default("OURS")
  text           String
  ownerId        String?
  dueAt          DateTime?
  status         String    @default("OPEN")
  keptAt         DateTime?
  sourceKind     String?
  sourceId       String?
  sourceAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, clientId])
}

// WHERE THE CLIENT STANDS — the saved AI summary at the top of the client's page, rebuilt when something newer
// than `builtAt` lands on the timeline. `nextAction` is the one next step it ends on.
model ClientBrief {
  clientId       String   @id
  organizationId String
  summary        String
  nextAction     String?
  builtAt        DateTime
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// TWO RECORDS OF ONE PERSON, FOLDED TOGETHER (part 1: duplicates found by phone and email; merging always asks
// first). The log row keeps what the removed record said, so the merge can be read back later.
model ClientMerge {
  id             String   @id @default(cuid())
  organizationId String
  keptId         String
  mergedId       String
  mergedName     String
  mergedEmail    String?
  mergedPhone    String?
  movedJson      String? // counts of what moved, by table
  byUserId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, keptId])
}

// THE INBOX (Smart CRM part 2, 2026-11-08 — the plan doc "JobFlex Smart CRM — plan"): one thread per client.
// The thread is the conversation's spine: who it is (a client when known — one thread per client — else the sender's
// email or phone until someone links it), where it stands (OPEN · NEEDS_REPLY · WAITING on the client · CLOSED),
// and what the AI read in the newest inbound message (aiReadJson, drawn by the page's "what this means" panel).
// `replyToken` names the thread in our Reply-To address (c-<token>@<the receiving domain>), so a client's email
// reply lands here without any login. Texts and desk calls stay in their own tables and are merged into the
// thread's view by phone; ClientMessage holds what has no other home — inbound emails (body kept), replies sent
// from the inbox, and portal notes.
model ClientThread {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  leadId         String?
  name           String
  email          String?
  phone          String?
  replyToken     String   @unique @default(cuid())
  status         String   @default("OPEN") // OPEN | NEEDS_REPLY | WAITING | CLOSED
  urgent         Boolean  @default(false)
  assignedToId   String?
  unread         Int      @default(0)
  lastAt         DateTime @default(now())
  lastPreview    String?
  lastDirection  String? // IN | OUT
  lastChannel    String? // EMAIL | SMS | CALL | PORTAL | NOTE
  aiReadJson     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo   User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     ClientMessage[]

  @@unique([organizationId, clientId])
  @@index([organizationId, status, lastAt])
  @@index([organizationId, lastAt])
}

model ClientMessage {
  id             String   @id @default(cuid())
  organizationId String
  threadId       String
  direction      String // IN | OUT
  channel        String // EMAIL | PORTAL | NOTE
  fromAddr       String?
  toAddr         String?
  subject        String?
  body           String
  attachmentsJson String?
  rawUrl         String?
  externalId     String?  @unique
  emailMessageId String?
  sentById       String?
  aiReadJson     String?
  status         String   @default("RECEIVED") // RECEIVED | SENT | FAILED
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       ClientThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId, threadId, createdAt])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  label          String
  color          String @default("#4F46E5")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients      ClientTag[]

  @@unique([organizationId, label])
}

model ClientTag {
  clientId String
  tagId    String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  projectType    String?
  description    String?
  photos         String?   @default("[]")
  source         String?
  status         String    @default("NEW")
  aiCategory     String?
  // The professional scope carried over from the platform lead (2026-09-21).
  scope          String?
  aiConfidence   Float?
  assignedToId   String?
  claimedById    String?
  claimedAt      DateTime?
  contactedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  claimedBy    User?           @relation("LeadClaimer", fields: [claimedById], references: [id])
  activities   ActivityEvent[]
  phoneCalls   AiPhoneCall[]
  appointments Appointment[]
  bookings     Booking[]

  @@index([organizationId, status])
  @@index([assignedToId])
}

model HomeownerRequest {
  id              String        @id @default(cuid())
  organizationId  String?
  name            String
  email           String
  phone           String?
  address         String?
  zip             String?
  projectType     String?
  description     String?
  photos          String?       @default("[]")
  createdAt       DateTime      @default(now())
  convertedLeadId String?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Lead Center — platform-owned homeowner leads auto-routed to the best org.
// A PlatformLead is the routing state machine (HomeownerRequest stays the raw
// immutable submission log); the org-scoped Lead row is created only when an
// offer is accepted or an admin manually assigns. SQLite-safe string statuses
// live in src/lib/prismaEnums.ts (PlatformLeadStatus / LeadOfferStatus).
// ─────────────────────────────────────────────

model PlatformLead {
  id                 String    @id @default(cuid())
  homeownerRequestId String?   @unique
  name               String
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  lat                Float?
  lng                Float?
  projectType        String?
  description        String?
  photos             String?   @default("[]")
  detectedTrade      String? // canonical TRADE_TYPES value (src/lib/tradeTypes.ts)
  // The request written for a contractor — what exists, what is to be done,
  // the sizes stated, what to confirm on site (lib/leadScope, 2026-09-21).
  // Null when the model was not reachable; the homeowner's words stand.
  scope              String?
  aiConfidence       Float?
  status             String    @default("MATCHING") // MATCHING | OFFERED | MATCHED | MANUAL_QUEUE
  attemptCount       Int       @default(0)
  // Capability token for the homeowner's status page (/request/[token]) — the
  // secret IS the authorization, like jf_admin's HMAC or CRON_SECRET. Nullable:
  // rows created before the page existed never got one and stay unreachable.
  accessToken        String?   @unique
  rankingJson        String? // snapshot: ordered [{orgId,orgName,score,distanceMi,distanceScore,ratingScore,respScore,fallback}]
  queueReason        String? // NO_CANDIDATES | EXHAUSTED
  matchedOrgId       String?
  matchedLeadId      String?
  matchedAt          DateTime?
  assignedByAdminId  String? // set when a platform admin manually assigns
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  // A test lead (2026-10-03): made through /homeowner?test=<key> or the admin's
  // "Create test lead". Never cascades, goes only to isInternal organizations,
  // and stays out of the Lead Center's statistics.
  isTest             Boolean   @default(false)
  // The homeowner's home dashboard this request belongs to (2026-10-03,
  // model Home): set by the intake, or adopted later by the email.
  homeId             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  offers LeadOffer[]
  home   Home?       @relation(fields: [homeId], references: [id])

  @@index([status, createdAt])
  @@index([homeId])
}

// Where a homeowner request came from and what the homeowner agreed to
// (2026-10-26). `source`: the public cost guides (/cost/<work>/<city>) send
// "seo:<work>:<city>" through /homeowner; null for any other start. The
// consent columns keep the TCPA consent the request was sent with — the exact
// words shown beside the ticked box (lib/leadConsent), when, from which IP
// and on which page. One row per PlatformLead, written by the intake for
// every request. No foreign key, like EmailLog — a write that fails never
// costs the request (lib/leadCenter/intake).
model LeadSource {
  id             String    @id @default(cuid())
  platformLeadId String    @unique
  source         String?
  consentText    String?
  consentAt      DateTime?
  consentIp      String?
  consentPage    String?
  createdAt      DateTime  @default(now())

  @@index([source])
}

// ─────────────────────────────────────────────
// The homeowner's home dashboard (2026-10-03)
// ─────────────────────────────────────────────
// Made by the first request a homeowner submits, keyed by their email; the
// emailed link is the login. Every later request with that email joins it,
// so one page holds the house's projects, the plans for the next ones and
// what was said to the contractors. See lib/home/portal.

model Home {
  id          String    @id @default(cuid())
  // Lowercased: the one identity a request carries.
  email       String    @unique
  name        String
  phone       String?
  address     String?
  city        String?
  state       String?
  zip         String?
  // Capability token for /home/[key] — the emailed link IS the authorization.
  accessToken String    @unique
  // The browser's zone at the first submission; reminders land at 9 AM there.
  timezone    String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads        PlatformLead[]
  plans        HomePlan[]
  messages     HomeMessage[]
  files        HomeFile[]
  fileRequests HomeFileRequest[]
}

// THE JOB FOLDER (2026-10-03): the pictures, videos and documents of one
// request, from the homeowner's dashboard (or asked for by the contractor),
// kept in the private file store (lib/media/privateStore) and read by the
// homeowner through the key and by the shop that has the lead. A file a
// contractor puts on a proposal is copied there; the folder keeps the original.
model HomeFile {
  id             String    @id @default(cuid())
  homeId         String
  platformLeadId String
  // The shop the request was with when the file arrived, told about it.
  organizationId String?
  // The stored URL (private blob, local: in development, data: before the
  // store exists) — read through /api/home-file/[id], never handed out.
  url            String
  name           String
  contentType    String
  bytes          Int
  media          String // photo | video | document
  note           String?
  uploadedBy     String    @default("HOMEOWNER") // HOMEOWNER | CONTRACTOR
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, createdAt])
  @@index([homeId])
}

// "Could you send pictures of the attic?" — a shop's ask, answered by the next
// upload on that request.
model HomeFileRequest {
  id             String    @id @default(cuid())
  homeId         String
  platformLeadId String
  organizationId String
  note           String?
  requestedById  String?
  createdAt      DateTime  @default(now())
  fulfilledAt    DateTime?

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, fulfilledAt])
}

// A project the homeowner means to do: on the dashboard's calendar, with a reminder when its month comes, and one tap away from becoming a request.
model HomePlan {
  id             String    @id @default(cuid())
  homeId         String
  title          String
  notes          String?
  // The month (its first day) or the day the homeowner has in mind.
  plannedFor     DateTime
  wholeMonth     Boolean   @default(true)
  remindAt       DateTime?
  remindedAt     DateTime?
  status         String    @default("PLANNED") // PLANNED | SUBMITTED | DONE | DROPPED
  // The request it became, once submitted from the dashboard.
  platformLeadId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, status])
  @@index([status, remindAt])
}

// What the homeowner wrote to a contractor from the dashboard — emailed to the shop with the homeowner as reply-to, and kept on the project.
model HomeMessage {
  id             String   @id @default(cuid())
  homeId         String
  platformLeadId String
  organizationId String
  body           String
  // False when no mail transport could carry it (the row still stands).
  emailed        Boolean  @default(false)
  createdAt      DateTime @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, createdAt])
}

model LeadOffer {
  id                 String    @id @default(cuid())
  platformLeadId     String
  organizationId     String
  attempt            Int // 1..3
  status             String    @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | EXPIRED | CANCELLED | REJECTED_BY_CLIENT
  score              Float
  scoreBreakdownJson String? // {distanceMi,distanceScore,ratingScore,respScore,total,fallback}
  // Why the homeowner asked for another contractor (REJECTED_BY_CLIENT rows
  // only) — one of the portal's canned options or their own words. Optional by
  // design: the dialog skips in one tap.
  declineReason      String?
  expiresAt          DateTime
  respondedAt        DateTime?
  respondedById      String?
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  unlockedAt         DateTime? // schema-ready masking gate; unused in v1
  createdAt          DateTime  @default(now())

  platformLead PlatformLead @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([platformLeadId, organizationId]) // an org is never offered the same lead twice
  @@index([organizationId, status])
  @@index([status, expiresAt]) // cron expiry sweep
}

// ─────────────────────────────────────────────
// Proposals + Money
// ─────────────────────────────────────────────

model Proposal {
  id             String  @id @default(cuid())
  publicId       String  @unique
  // Which estimator made it — "fence", "roof", "hvac" — so the trade boards
  // (2026-09-20) list it and its materials count against that trade's stock.
  trade          String?
  organizationId String
  ownerId        String?
  clientId       String?
  // The project the proposal belongs to (2026-09-18). Its change orders and
  // the job it becomes follow it there. Null = not in a project.
  projectId      String?
  title          String
  description    String?
  scopeOfWork    String?
  notes          String?
  // Job address — optional one-liner, seeded from the client / AI-estimator
  // location; its state drives the tax-rate estimate in the builder.
  address        String?
  status         String  @default("DRAFT")
  subtotal       Float   @default(0)
  discountTotal  Float   @default(0)
  taxRate        Float   @default(0)
  taxTotal       Float   @default(0)
  total          Float   @default(0)
  currency       String  @default("USD")

  // Estimating engine — markup ladder applied to base material/labor costs
  materialMarkupPct Float     @default(0)
  laborMarkupPct    Float     @default(0)
  overheadPct       Float     @default(0)
  profitPct         Float     @default(0)
  // "Show to client" (owner, 2026-09-17): how each line's price reads on the
  // client's copy — one total, or its labor and material halves — and whether
  // the scope and the signature lines print. Presentation only; never the price.
  showBreakdown     Boolean   @default(true)
  showScope         Boolean   @default(true)
  showSignature     Boolean   @default(true)
  // Where overhead and profit land inside the breakdown: across both halves
  // (false) or in the labor half, materials reading at cost (true). They are
  // always inside the line prices, never a row of their own.
  marginOnLabor     Boolean   @default(false)
  validUntil        DateTime?
  sentAt            DateTime?
  viewedAt          DateTime?
  viewCount         Int       @default(0)
  acceptedAt        DateTime?
  acceptedIp        String?
  declinedAt        DateTime?
  paidAt            DateTime?
  pdfUrl            String?
  aiDraftId         String?
  beforePhotos      String?   @default("[]")
  afterPhotos       String?   @default("[]")
  // Bumped whenever an UNPAID installment's amount/label/membership changes.
  // Checkout sessions carry the version they were minted under, so a payment
  // landing on a stale version is reconciled instead of trusted blindly.
  scheduleVersion   Int       @default(1)
  // Automatic payment reminders for THIS proposal: true / false override the
  // company's reminder mode; null follows it (settings → payments).
  remindersOn       Boolean?
  // "Listen to this proposal" (2026-09-23): the spoken summary's cached audio
  // file and the hash of the script it was read from (lib/proposalAudio). A
  // price change moves the hash and the next play regenerates the audio.
  audioUrl          String?
  audioScriptHash   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?             @relation("ProposalOwner", fields: [ownerId], references: [id])
  audio          ProposalAudio?
  client         Client?           @relation(fields: [clientId], references: [id])
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lineItems      LineItem[]
  discounts      Discount[]
  installments   Installment[]
  invoices       Invoice[]
  payments       Payment[]
  activities     ActivityEvent[]
  jobs           Job[]
  changeOrders   ChangeOrder[]
  aiDraft        AiDraft?          @relation(fields: [aiDraftId], references: [id])
  snapshots      PricingSnapshot[]
  appointments   Appointment[]
  reviewRequests ReviewRequest[]

  @@index([organizationId, status])
  @@index([publicId])
  @@index([projectId])
}

model PricingSnapshot {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  reason         String   @default("manual") // manual | sent | accepted | edited
  subtotal       Float
  discountTotal  Float    @default(0)
  taxRate        Float    @default(0)
  taxTotal       Float
  total          Float
  currency       String   @default("USD")
  lineItemsJson  String // JSON-encoded snapshot of line items
  createdAt      DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

// "Listen to this proposal" (2026-09-24): the spoken summary's MP3, kept in
// the database — production has no Blob store, and a forty-second file is a
// few hundred kilobytes. One per proposal; a new script replaces it. Served
// by /api/public-quote/[publicId]/audio/file, cached for a year by hash.
model ProposalAudio {
  proposalId String   @id
  hash       String
  model      String
  voice      String
  bytes      Bytes
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model LineItem {
  id              String  @id @default(cuid())
  proposalId      String
  name            String
  description     String?
  measurementType String  @default("UNIT")
  quantity        Float   @default(1)
  unitPrice       Float   @default(0)
  materialCost    Float   @default(0)
  laborCost       Float   @default(0)
  total           Float   @default(0)
  position        Int     @default(0)

  // Live-pricing product metadata from the AI estimator's SerpAPI matches, so
  // the Materials Request view can render a shoppable line. Null for hand-typed
  // or labor lines.
  store      String?
  productUrl String?
  imageUrl   String?
  dimensions String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Discount {
  id         String  @id @default(cuid())
  proposalId String
  label      String
  amount     Float   @default(0)
  isPercent  Boolean @default(false)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Installment {
  id               String    @id @default(cuid())
  proposalId       String
  label            String
  amount           Float
  isPercent        Boolean   @default(false)
  dueDate          DateTime?
  position         Int       @default(0)
  // Payment-stage state (src/lib/paymentSchedule.ts is the only place that
  // derives money from these). UNPAID | PENDING (a checkout is open) | PAID |
  // WAIVED (proposal reached PAID before this stage was collected).
  status           String    @default("UNPAID")
  paidAt           DateTime?
  // Frozen dollars actually settled for this stage. A PAID stage never
  // recomputes from `amount`/`isPercent` again, even if the total changes.
  paidAmount       Float?
  paymentId        String?
  // Open checkout, while PENDING: provider + its session/link id (+ Square's
  // order id, which is what payment.updated carries back).
  checkoutProvider String?
  checkoutRef      String?
  checkoutOrderId  String?
  checkoutOpenedAt DateTime?
  // Set when an approved change order created this stage. Such a stage is
  // locked: the proposal builder neither drops nor re-prices it.
  changeOrderId    String?   @unique
  // Payment reminders (2026-09-13): when the client was last nudged for this
  // stage and how many rungs of the ladder have gone out (auto or manual).
  remindedAt       DateTime?
  reminderCount    Int       @default(0)
  // The last invoice sent for this stage and the rail the office chose for it
  // (card | bank | any) — the portal link carries the choice.
  invoiceMethod    String?
  invoiceSentAt    DateTime?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([proposalId, position])
  @@index([checkoutRef])
  @@index([checkoutOrderId])
}

model ProposalTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  proposalId     String?
  clientId       String?
  number         String
  /// What this row is worth in every money total: the ask while it is open,
  /// and what actually landed on its installments once it is settled.
  amount         Float
  /// What the client was ASKED for, stamped when the invoice was sent and left
  /// alone afterwards. Settlement re-states `amount`, so without this the
  /// figure in the client's email would be lost; the book shows both when they
  /// differ. Null on rows nobody was sent (a receipt settlement wrote itself,
  /// and every row that predates this column).
  billedAmount   Float?
  status         String    @default("PENDING")
  provider       String    @default("MANUAL")
  externalId     String?
  dueDate        DateTime?
  paidAt         DateTime?
  // The service plan this invoice bills (2026-09-22); null for a proposal invoice.
  servicePlanId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])
  payments     Payment[]
  servicePlan  ServicePlan? @relation(fields: [servicePlanId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model Payment {
  id                String    @id @default(cuid())
  organizationId    String
  proposalId        String?
  invoiceId         String?
  clientId          String?
  amount            Float
  currency          String    @default("USD")
  provider          String    @default("STRIPE") // STRIPE | SQUARE | MANUAL
  status            String    @default("PENDING") // PENDING | PAID | PARTIAL | REFUNDED | PARTIALLY_REFUNDED | VOID
  externalId        String? // Stripe checkout session id / Square order id — dedupe key
  method            String? // card | us_bank_account | BANK_TRANSFER | CASH | CHECK | OTHER
  paidAt            DateTime?
  // Platform payments (contractor's own Stripe/Square via JobFlex). Money in
  // dollars like `amount`; the settle path is the only writer.
  feeAmount         Float     @default(0) // JobFlex application fee
  netAmount         Float? // amount − feeAmount
  externalPaymentId String? // Stripe payment_intent / Square payment id — refunds key on this
  livemode          Boolean   @default(true)
  refundedAmount    Float     @default(0)
  scheduleVersion   Int? // Proposal.scheduleVersion the checkout was minted under
  meta              String? // JSON: {orphan, unappliedMinor, duplicate, note}
  // Key-joined Stripe: the fee can't ride inside the charge, so it is billed
  // as an invoice item on the org's JobFlex subscription — the `ii_…` id once
  // that happened. Null on a key-joined payment = accrued in the ledger only
  // (no subscription customer to bill), for the operator to collect by hand.
  feeInvoiceItemId  String?
  createdAt         DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?     @relation(fields: [proposalId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  installments Installment[]

  @@unique([provider, externalId])
  @@index([organizationId, status])
  @@index([provider, externalPaymentId])
}

// One row per org × provider for "get paid through JobFlex". Stripe = either a
// Connect Standard account joined by OAuth (we store only the acct id — every
// API call uses the platform key + Stripe-Account header) or, since
// 2026-09-12, the contractor's OWN API key pasted in Settings (stripeKeyEnc,
// encrypted at rest — every call uses that key, no header, no application
// fee). Square = OAuth tokens, encrypted at rest (src/lib/crypto/secretBox.ts).
// Disconnect = delete row.
model PaymentConnection {
  id             String @id @default(cuid())
  organizationId String
  provider       String // STRIPE | SQUARE
  status         String @default("ACTIVE") // ACTIVE | RESTRICTED | REVOKED

  stripeAccountId        String?
  stripeLivemode         Boolean?
  stripeChargesEnabled   Boolean  @default(false)
  stripeDetailsSubmitted Boolean  @default(false)
  stripeAchEnabled       Boolean  @default(false)
  // "Paste an API key" join: the contractor's secret (sk_) or restricted (rk_)
  // key, AES-GCM at rest. Present = this row charges with the key itself;
  // JobFlex's cut is billed separately (Payment.feeInvoiceItemId).
  stripeKeyEnc           String?
  stripeKeyKind          String? // sk | rk
  stripeKeyLast4         String?
  // Webhook endpoint registered ON THE CONTRACTOR'S account with that key,
  // pointed at /api/webhooks/stripe-key/<this row's id>, and its signing
  // secret (Stripe returns it once, at creation). Null = registration failed;
  // the portal's active verification + the reconcile cron still settle.
  stripeWebhookId        String?
  stripeWebhookSecretEnc String?

  squareMerchantId             String?
  squareLocationId             String?
  squareLocationName           String?
  squareAccessTokenEnc         String?
  squareRefreshTokenEnc        String?
  squareTokenExpiresAt         DateTime?
  squareEnv                    String? // sandbox | production at connect time
  // "Paste an access token" join (2026-09-13): the seller's own personal
  // access token from their Square developer app — no refresh token, no
  // expiry, and no app fee (that needs the platform app), so JobFlex's cut is
  // billed on the JobFlex invoice. squareAuth = oauth | token.
  squareAuth                   String?
  squareTokenLast4             String?
  // Webhook subscription registered on THEIR app with that token, pointed at
  // /api/webhooks/square-key/<this row's id>, and its signature key.
  squareWebhookId              String?
  squareWebhookSignatureKeyEnc String?

  // Stax (2026-09-13): the merchant API key pasted in Settings, encrypted at
  // rest. Stax webhook payloads are unsigned, so the target URL carries a
  // random secret and every event is re-read from Stax before it settles
  // anything. staxWebhookIds = JSON array of the webhook ids we registered.
  staxApiKeyEnc        String?
  staxKeyLast4         String?
  staxMerchantId       String?
  staxMerchantName     String?
  staxWebhookIds       String?
  staxWebhookSecretEnc String?

  currency          String? // provider default currency; checked against Proposal.currency
  country           String? // Square app-fee same-country rule
  lastError         String?
  connectedByUserId String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  // One Stripe account, one workspace (audit, 2026-09-20): the webhook
  // handlers resolve the org from acct_… and a second row on the same
  // account would make that lookup arbitrary. Nulls are distinct, so rows
  // without an account id (Square, Stax) are unaffected.
  @@unique([stripeAccountId, provider])
  @@index([squareMerchantId])
}

// ─────────────────────────────────────────────
// Scheduling + Jobs + Workers
// ─────────────────────────────────────────────

model Job {
  id                String    @id @default(cuid())
  organizationId    String
  clientId          String?
  proposalId        String?
  projectId         String?
  title             String
  status            String    @default("SCHEDULED")
  scopeOfWork       String? // seeded from the linked proposal's scope; shown above notes on the job
  // When the crew marked the pick list loaded from the warehouse (2026-09-20).
  materialsLoadedAt DateTime?
  notes             String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id])
  proposal       Proposal?       @relation(fields: [proposalId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events         JobEvent[]
  assignments    JobAssignment[]
  photos         JobPhoto[]
  expenses       JobExpense[]
  workDays       WorkDay[]
  messages       JobMessage[]
  conversation   Conversation?
  changeOrders   ChangeOrder[]
  reviewRequests ReviewRequest[]
  crewHours      CrewHours[]
  flags          JobFlag[]
  punchItems     PunchItem[]

  @@index([organizationId, status])
  @@index([projectId])
}

model JobEvent {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?
  // Who created it — lets a jobless event (installer's optional-job path) still
  // render on its creator's own calendar. Nullable: legacy events have none.
  createdById    String?
  title          String
  startsAt       DateTime
  endsAt         DateTime
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id])
  createdBy    User?        @relation("JobEventCreator", fields: [createdById], references: [id])

  @@index([organizationId, startsAt])
}

model WorkerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  organizationId String
  displayName    String
  phone          String?
  // Text messages (2026-09-24): the office ticks "text their schedule" and the
  // worker gets a welcome text with the STOP line; a STOP reply wins over it.
  smsOptIn       Boolean   @default(false)
  smsOptedInAt   DateTime?
  specialties    String?   @default("[]")
  hourlyRate     Float?
  token          String    @unique @default(cuid())
  // Invite lifecycle: PENDING (sent, awaiting response) → ACCEPTED / DECLINED.
  // Defaults to ACCEPTED so legacy profiles (created before this feature) stay
  // active; createWorkerInvite sets PENDING explicitly for new/re-invites.
  // DECLINED is excluded from the "workers" plan-limit count (frees the seat).
  inviteStatus   String    @default("ACCEPTED")
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  // Rolling "last time this worker was genuinely active in their portal" (see
  // touchWorkerActivity). Nullable: existing rows stay null until the one-time
  // backfill runs. The inactivity cron NEVER revokes a null row — only a real
  // date older than 6 months — so null is always safe.
  lastSeenAt     DateTime?

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments            JobAssignment[]
  appointmentAssignments AppointmentAssignment[]
  hours                  CrewHours[]

  @@index([organizationId])
  @@index([lastSeenAt])
}

model JobAssignment {
  id         String    @id @default(cuid())
  jobId      String
  workerId   String
  status     String    @default("PENDING")
  assignedAt DateTime  @default(now())
  pingedAt   DateTime?
  // What this worker is paid for this job — the office sets it when the job
  // is handed over (2026-09-20). It is the crew cost of the job, never the
  // client's price, and it is what the worker sees on their own card.
  pay        Float     @default(0)
  // Marked by the office when the pay has actually been handed over.
  paidAt     DateTime?

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  // Worker-side lists and badge counts read by workerId, newest first.
  @@index([workerId, assignedAt])
}

// A DAY ON SITE (2026-09-30, stage A of crew days / media / worker expenses).
// One row per job and local date (the organization's timezone), opened by a
// Start or a Back-on-site press — or by the office moving the status — and
// closed by the crew with a note or at least one photo / video of the day.
// A day left open past its date reads PENDING ("passed, needs closing") and
// can be closed later. Several crew on one job share the one day.
// Status: OPEN | CLOSED | PENDING (src/lib/prismaEnums.ts WorkDayStatus).
model WorkDay {
  id             String    @id @default(cuid())
  jobId          String
  organizationId String
  // "2026-09-30" in the organization's timezone.
  date           String
  dayNumber      Int
  status         String    @default("OPEN")
  openedById     String?
  closedById     String?
  closedAt       DateTime?
  note           String?
  // worker | office — who opened it.
  source         String    @default("worker")
  // The weather the day it was opened, noted by itself from the job's address ("48–61°F, light rain") — the
  // crew build, 2026-11-05 (lib/weather). Null when nothing could be read.
  weather        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos       JobPhoto[]

  @@unique([jobId, date])
  @@index([organizationId, status])
}

model JobPhoto {
  id           String    @id @default(cuid())
  jobId        String
  url          String
  kind         String    @default("BEFORE")
  caption      String?
  analysis     String? // JSON-encoded vision output
  createdAt    DateTime  @default(now())
  // Stage A (2026-09-30): the columns behind the crew's gallery. Older rows
  // leave them null and are read as before (the analysis JSON marks a video).
  uploadedById String?
  workDayId    String?
  // photo | video
  media        String?
  contentType  String?
  bytes        Int?
  // Set when the crew edits the caption after upload ("edited" mark).
  editedAt     DateTime?
  // Chosen for the client's project page (the client build, 2026-11-06): the office picks which photos the
  // homeowner sees; null = theirs alone.
  sharedAt     DateTime?

  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workDay   WorkDay?   @relation(fields: [workDayId], references: [id], onDelete: SetNull)
  punchItem PunchItem?

  @@index([workDayId])
}

model JobExpense {
  id             String    @id @default(cuid())
  // Null for a purchase FOR STOCK (stage D, 2026-09-30): the money is the
  // company's the day it is spent and the warehouse's value; it reaches a job
  // only when the stock is issued to it (InventoryMovement PICKED / USED at
  // its unitCost). A receipt for a job is purpose JOB with its jobId.
  jobId          String?
  category       String
  amount         Float
  note           String?
  receiptUrl     String?
  ocrJson        String? // JSON-encoded OCR output
  createdAt      DateTime  @default(now())
  // Stage A (2026-09-30): a worker's receipt is SUBMITTED and counts nowhere
  // until the owner or a manager APPROVES it (or REJECTS it with a reason);
  // REIMBURSED marks the money handed back to a worker who paid from their
  // own pocket (paidBy WORKER). Rows from before the change read APPROVED
  // and COMPANY, so no total moved. (src/lib/prismaEnums.ts ExpenseStatus.)
  organizationId String?
  submittedById  String?
  paidBy         String    @default("COMPANY")
  status         String    @default("APPROVED")
  rejectReason   String?
  reviewedById   String?
  reviewedAt     DateTime?
  reimbursedAt   DateTime?
  vendor         String?
  // When the money was spent; the totals go by it (createdAt when null).
  spentAt        DateTime?
  // Set when the row is edited after it was submitted ("edited" mark).
  editedAt       DateTime?
  // "JOB" | "STOCK" — what the money bought (stage D). STOCK rows have no job;
  // the item and quantity, when given, set the item's lastCost on approval.
  purpose        String    @default("JOB")
  stockItemId    String?
  stockQty       Float?

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model JobMessage {
  id        String   @id @default(cuid())
  jobId     String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Comms
// ─────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?  @unique
  // DIRECT (1:1) | GROUP (manager-created, multi-person) | JOB (auto-created from a job's crew)
  kind           String   @default("DIRECT")
  title          String?
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([organizationId, createdAt])
  @@index([organizationId, kind])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime  @default(now())
  lastReadAt     DateTime?
  // Per-person "clear thread" watermark: this participant sees only messages
  // newer than this. Clearing NEVER deletes Message rows — the other side
  // keeps their copy (owner request 2026-08-21).
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Per-user "last looked at this nav surface" timestamps. Drives view-based
// clearing of the sidebar/tab-bar badges: a badge counts only items newer than
// the user's seenAt for that surface, so visiting the page clears it until
// something new arrives. `key` is a short surface id ("leads" | "proposals" |
// "hire" | "referrals" | "reviews"). Scalar userId/organizationId (no
// relations) keeps the blast radius to this one model; orphaned rows after a
// delete are harmless. The unique index doubles as the lookup index.
model NavSeen {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  key            String
  seenAt         DateTime @default(now())

  @@unique([userId, organizationId, key])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  // Hot paths: the 5-second inbox poll (conversationId + createdAt > since),
  // unread groupBy, and the messagesSent plan meter (createdAt range).
  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([createdAt])
}

model Announcement {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String
  priority       Int       @default(0)
  scope          String    @default("ORG") // ORG | PLATFORM
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([scope, createdAt])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  category       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Automation
// ─────────────────────────────────────────────

model FollowUpRule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  triggerStatus  String
  delayMinutes   Int
  enabled        Boolean @default(true)
  template       String?
  /// One of the starter rules every company gets (lib/followUps/defaults).
  /// Deleting one turns it off instead, so ensureDefaultFollowUpRules never
  /// brings it back.
  isDefault      Boolean @default(false)
  /// Which starter rule this row is (DEFAULT_RULES key); null on the owner's own rules.
  defaultKey     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, defaultKey])
}

model FollowUp {
  id             String    @id @default(cuid())
  organizationId String
  proposalId     String?
  runAt          DateTime
  completedAt    DateTime?
  note           String?
  templateId     String? // EmailTemplate chosen by the rule that scheduled this

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, runAt])
}

// ─────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────

model AiDraft {
  id             String   @id @default(cuid())
  organizationId String
  prompt         String
  model          String
  result         String
  tokensIn       Int?
  tokensOut      Int?
  costCents      Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    Proposal[]
}

model AiPromptPack {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  purpose        String
  prompt         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AiEstimate {
  id             String   @id @default(cuid())
  organizationId String
  projectType    String
  location       String?
  materials      String
  labor          String
  categories     String
  assumptions    String?
  total          Float
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // estimatorUses plan meter counts rows per org per period.
  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────
// Activity
// ─────────────────────────────────────────────

model ActivityEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  clientId       String?
  leadId         String?
  proposalId     String?
  kind           String
  summary        String
  meta           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────
// Billing / Admin
// ─────────────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String    @unique
  plan                   String    @default("FREE")
  status                 String    @default("FREE")
  provider               String    @default("STRIPE")
  externalCustomerId     String?
  externalSubId          String?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  // Stripe-truth mirror fields, synced from subscription/invoice webhooks.
  stripePriceId          String?
  appliedPromotionCodeId String? // promo_... read off the subscription discount
  appliedCouponId        String? // coupon_... fallback
  attributionId          String? // → Attribution (influencer promo link)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  priceCents       Int // monthly price
  yearlyPriceCents Int? // optional annual price (enables yearly checkout + savings display)
  interval         String   @default("month")
  trialDays        Int      @default(0)
  order            Int      @default(0)
  features         String
  limitsJson       String? // numeric per-plan limits (see src/lib/planLimits.ts); null/absent key = unlimited
  active           Boolean  @default(true) // hidden from user surfaces + rejected at checkout when false
  highlight        Boolean  @default(false) // "Most popular" badge on plan surfaces
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model SupportTicket {
  id             String    @id @default(cuid())
  organizationId String
  userId         String? // submitter, when raised from the in-app support form
  subject        String
  body           String
  category       String    @default("general") // billing | technical | account | feature | general — for admin triage
  priority       String    @default("normal") // low | normal | high — submitter-declared urgency
  status         String    @default("OPEN")
  adminReadAt    DateTime? // platform-admin "seen" marker; null = new/unread in the admin notification feed — cleared again by every customer message
  lastMessageAt  DateTime  @default(now()) // the conversation's latest message (the ticket itself, then SupportMessage) — the queue's order
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([lastMessageAt])
}

// ── Why a plan was cancelled (owner, 2026-10-20) ────────────────────────────
// One row per cancellation booked from Settings → Billing → Manage
// subscription → … → "Cancel <plan>?" (actions/billing cancelSubscription),
// where the owner must tick at least one reason. `reasons` is a JSON array of
// lib/cancelFeedback keys; `otherText` is the "Other" box (3–500 chars) and
// null otherwise. `plan` and `periodEnd` are as they stood when it was booked.
// Read by /admin/cancellations and the /admin/users sheet.
model CancellationFeedback {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  plan           String
  reasons        String    @default("[]")
  otherText      String?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// ── More trial days, asked from "Before you go" (owner, 2026-10-20) ─────────
// Offered only while the plan is on its trial or the trial ended at most 14
// days ago (lib/trialExtension). One PENDING row per organization at a time.
// status: PENDING | APPROVED | DENIED. A platform admin decides in
// /admin/trial-requests: Approve moves the Stripe trial_end (or, for a plan
// with no Stripe subscription, only the local date — `localOnly`), Deny keeps
// a short reason. `plan`, `trialStartedAt` and `trialEndsAt` are as they stood
// when it was asked; `extendedUntil` is the trial end Approve set.
model TrialExtensionRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  requestedDays  Int
  note           String?
  status         String    @default("PENDING")
  plan           String?
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  grantedDays    Int?
  extendedUntil  DateTime?
  localOnly      Boolean   @default(false)
  decisionNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("TrialExtensionRequester", fields: [userId], references: [id], onDelete: SetNull)
  decider      User?        @relation("TrialExtensionDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

// ── Why plan charges fail (owner, 2026-10-21) ───────────────────────────────
// One row per declined try of a JobFlex plan invoice, written by the Stripe
// webhook (invoice.payment_failed) and by scripts/backfill-payment-failures.ts
// through the same code (lib/paymentFailures). The reason is the attempt's own
// (the payment intent's last_payment_error, else the failed charge); the card
// is the one charged. `ignored`: Stripe sent the failure, but nothing was owed
// — a declined plan change, or an old failure after the invoice was paid (the
// subscription is active or trialing). `isTrialEnd`: the first charge after a
// trial. `recoveredAt`: the invoice was paid in the end (invoice.paid). The
// organization is kept loose (SetNull) so a deleted company's failures still
// count. cardFunding: credit | debit | prepaid | unknown.
model PaymentFailure {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  organizationId       String?
  subscriptionId       String?
  stripeInvoiceId      String
  stripeSubscriptionId String?
  attempt              Int
  amountCents          Int
  currency             String    @default("usd")
  billingReason        String?
  declineCode          String?
  errorCode            String?
  errorMessage         String?
  cardBrand            String?
  cardFunding          String    @default("unknown")
  cardLast4            String?
  isTrialEnd           Boolean   @default(false)
  ignored              Boolean   @default(false)
  recoveredAt          DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([stripeInvoiceId, attempt])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

// ── The conversation under a support ticket (owner, 2026-10-17) ─────────────
// One dialog per ticket that either side can write to from anywhere: the
// customer in the app (/dashboard/support) or by email, the team in
// /admin/support or by email, the support AI (lib/support). The ticket's own
// `body` is the opening message and is not copied here. Replaced the SyncState
// `supportReplies:<ticketId>` JSON lists (capped at 50, team side only);
// prisma/sql/prod-2026-10-17-support-messages.sql moves those over.
// Vocabularies are free Strings checked in lib/supportReply.
model SupportMessage {
  id             String   @id @default(cuid())
  ticketId       String
  from           String // customer | team | ai
  authorUserId   String? // who wrote it, when a signed-in person did
  authorName     String? // as signed: the admin's name, "JobFlex support"; null for the customer
  body           String
  channel        String   @default("app") // app | email — where it was written
  kind           String? // the AI's sends: answer | ack | fixed
  sentTo         String? // where the email to the other side went (team/ai → the customer's address)
  emailMessageId String? // inbound: the letter's Message-ID (dedupe); outbound: the provider's id
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([emailMessageId])
}

// ── Admin task tracker (/admin/tasks, 2026-10-11) ───────────────────────────
// The platform admins' own to-do list. Only platform admins read or write it
// (requirePlatformAdmin in every action and in /api/admin/tasks/changes).
// Vocabularies are free Strings validated in lib/adminTasks/model.ts, like
// SupportTicket.status. A task is never deleted: Canceled sends it to Archive.
// Every write to a subtask or comment touches the task's updatedAt, which is
// what the live "changed since" poll reads.
model AdminTask {
  id              String    @id @default(cuid())
  title           String
  description     String    @default("")
  priority        String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status          String    @default("TODO") // TODO | IN_PROGRESS | BLOCKED | DONE | CANCELED
  category        String    @default("OTHER") // BUG | FEATURE | SUPPORT | BILLING | MARKETING | OTHER
  assigneeId      String?
  authorId        String?
  dueDate         String? // "2026-10-14" — a calendar day, no clock and no zone
  linkUrl         String? // the related object: an app path ("/admin/support?ticket=…") or a URL
  // The ticket a "Create task" on /admin/support made this from. A plain
  // column, not a relation, so SupportTicket itself is untouched.
  supportTicketId String?   @unique
  closedAt        DateTime? // set on Done / Canceled, cleared on reopen
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee User?              @relation("AdminTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author   User?              @relation("AdminTaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subtasks AdminTaskSubtask[]
  comments AdminTaskComment[]
  events   AdminTaskEvent[]

  @@index([updatedAt])
  @@index([status])
  @@index([assigneeId, status])
}

model AdminTaskSubtask {
  id         String   @id @default(cuid())
  taskId     String
  title      String
  done       Boolean  @default(false)
  assigneeId String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User?     @relation("AdminSubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
}

model AdminTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User?     @relation("AdminTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// The journal: who changed what, when. `from` / `to` are the values as they
// read at the time ("High", "Dana", "Oct 14"), so a later rename of a person
// or a subtask never rewrites history.
model AdminTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  kind      String // CREATED | TITLE | STATUS | PRIORITY | ASSIGNEE | DUE | CATEGORY | DESCRIPTION | LINK | SUBTASK_ADDED | SUBTASK_DONE | SUBTASK_REOPENED | SUBTASK_RENAMED | SUBTASK_REMOVED | SUBTASK_ASSIGNED
  from      String?
  to        String?
  createdAt DateTime @default(now())

  task  AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User?     @relation("AdminTaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Specialty {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  promptPreamble String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// ─────────────────────────────────────────────
// Stage 2E — New domains
// ─────────────────────────────────────────────

model ChangeOrder {
  id                String    @id @default(cuid())
  organizationId    String
  // A change order amends a contract. It attaches to either a Job (legacy) or a
  // Proposal (the contract itself) — exactly one is set, enforced in the action.
  jobId             String?
  proposalId        String?
  title             String
  description       String?
  amount            Float // signed pre-tax delta: positive adds, negative reduces (legacy readers)
  status            String    @default("DRAFT") // DRAFT | SENT | APPROVED | DECLINED | VOID
  publicToken       String    @unique @default(cuid())
  sentAt            DateTime?
  approvedAt        DateTime?
  declinedAt        DateTime?
  approvedIp        String?
  // ── Itemized change orders (2026-09-13). All nullable: a row from before
  // this carries only `amount`, and an APPROVED row with `total` null was
  // already folded into its proposal's total by the old approval code, so the
  // contract-total derivation (lib/contractTotal) excludes it. ──
  number            Int? // per proposal: "CO #2"
  kind              String? // change-order type key: plywood_sheathing | custom | an org-authored key
  linesJson         String? // [{ key, name, quantity, unit, unitPrice, kind: material|labor, meta }]
  taxable           Boolean   @default(true)
  taxRate           Float? // copied from the proposal at send — a later rate edit cannot move a sent order
  taxTotal          Float?
  total             Float? // amount + taxTotal, rounded to cents; the installment an approval creates
  photosJson        String?   @default("[]") // [{ id, url, caption }] on Blob
  reason            String? // why the client is paying more — shown on the client page
  approvedName      String? // the client's typed full name (lightweight e-sign)
  approvedVia       String? // client | in_person
  approvedByUserId  String? // the staff member who recorded an in-person approval
  approvedUserAgent String?
  declineReason     String?
  createdByUserId   String?
  voidedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([proposalId, status])
  @@index([organizationId, status])
}

/// An org-authored change-order type — a form definition the generic sheet
/// renders (items with suggested prices, quantity helpers, photo/reason
/// flags). Built-in types (plywood / sheathing, custom) live in code
/// (src/lib/changeOrders/types.ts); rows here add more without a release.
model ChangeOrderType {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  label          String
  definitionJson String
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

/// The contractor's own price for a change-order item, per company: the
/// suggested price is a default; an override here is what the sheet pre-fills
/// next time, along with the last quantity entered.
model ChangeOrderPricePref {
  id             String   @id @default(cuid())
  organizationId String
  typeKey        String
  itemKey        String
  unitPrice      Float
  lastQuantity   Float?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, typeKey, itemKey])
}

model ReviewRequest {
  id             String    @id @default(cuid())
  organizationId String
  // A request hangs off the JOB that was finished or the PROPOSAL that was
  // marked complete — at least one of the two, often both (a job carries its
  // proposal). Both optional since 2026-09-13: a proposal completed by hand
  // with no job behind it still gets a review link.
  jobId          String?
  proposalId     String?
  clientId       String?
  publicToken    String    @unique @default(cuid())
  status         String    @default("PENDING") // PENDING (no client email) | SENT | COMPLETED
  rating         Int?
  comment        String?
  // JSON string[] of photo URLs the client attached (blob URLs; max 6).
  photosJson     String    @default("[]")
  // Contractor hid this review from the public /r/[slug] page and the portal
  // badge. It still counts in the dashboard average and in lead routing.
  hiddenAt       DateTime?
  // The one 7-day reminder was sent (or attempted) — never re-sent.
  remindedAt     DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId, status])
  @@index([jobId])
  @@index([proposalId])
}

model ReferralCode {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  code           String   @unique
  rewardAmount   Float    @default(50)
  rewardType     String   @default("CREDIT") // CREDIT | CASH | DISCOUNT
  note           String?
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions  ReferralConversion[]

  @@index([organizationId])
  @@index([userId])
}

model ReferralConversion {
  id                String    @id @default(cuid())
  codeId            String
  signupEmail       String
  signupOrgId       String?
  status            String    @default("PENDING") // PENDING | CONVERTED | PAID
  note              String?
  createdAt         DateTime  @default(now())
  convertedAt       DateTime?
  // Reward credit tracking — PAID means a 50%-of-one-month Stripe customer-balance
  // credit landed on the referrer org (rewardStripeTxnId). CONVERTED with no
  // rewardAppliedAt = credit pending (referrer has no Stripe customer yet).
  rewardCents       Int?
  rewardAppliedAt   DateTime?
  rewardStripeTxnId String?

  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, status])
  @@index([signupOrgId, status])
}

model TradePost {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  title          String
  body           String
  category       String? // equipment | subcontractor | job-share | question
  status         String   @default("OPEN") // OPEN | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  replies      TradeReply[]

  @@index([organizationId, status])
}

model TradeReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   TradePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
}

// ─────────────────────────────────────────────
// Trade & Services — contractor-to-contractor job network (cross-org, opt-in)
// SQLite-safe: statuses are checked Strings, specialties/tradeTypes are JSON strings.
// ─────────────────────────────────────────────

model TradeNetworkProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  optIn       Boolean  @default(false)
  tradeTypes  String   @default("[]") // JSON string[] of trades this contractor does
  specialties String   @default("[]") // JSON string[] of skills
  serviceArea String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([optIn])
}

model TradeJob {
  id          String   @id @default(cuid())
  authorId    String
  authorOrgId String
  title       String
  description String
  tradeType   String
  specialties String   @default("[]") // JSON string[]
  location    String?
  budget      String?
  timeWindow  String?
  urgency     String? // low | medium | high | urgent
  status      String   @default("OPEN") // OPEN | FILLED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        User                   @relation("TradeJobAuthor", fields: [authorId], references: [id])
  recipients    TradeJobRecipient[]
  conversations TradeJobConversation[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model TradeJobRecipient {
  id              String    @id @default(cuid())
  tradeJobId      String
  recipientId     String
  status          String    @default("NEW") // NEW | INTERESTED | NOT_INTERESTED
  interestedAt    DateTime?
  notInterestedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tradeJob  TradeJob @relation(fields: [tradeJobId], references: [id], onDelete: Cascade)
  recipient User     @relation("TradeJobRecipientUser", fields: [recipientId], references: [id])

  @@unique([tradeJobId, recipientId])
  @@index([recipientId, status, updatedAt])
}

model TradeJobConversation {
  id          String   @id @default(cuid())
  tradeJobId  String
  authorId    String // job poster
  recipientId String // interested contractor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tradeJob  TradeJob          @relation(fields: [tradeJobId], references: [id], onDelete: Cascade)
  author    User              @relation("TradeJobConvAuthor", fields: [authorId], references: [id])
  recipient User              @relation("TradeJobConvRecipient", fields: [recipientId], references: [id])
  messages  TradeJobMessage[]

  @@unique([tradeJobId, recipientId])
  @@index([authorId])
  @@index([recipientId])
}

model TradeJobMessage {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  conversation TradeJobConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User                 @relation("TradeJobMessageAuthor", fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────
// Stage 2F — Telephony & Advanced AI
// ─────────────────────────────────────────────

model AiPhoneCall {
  id              String    @id @default(cuid())
  organizationId  String
  direction       String    @default("INBOUND") // INBOUND | OUTBOUND
  fromNumber      String
  toNumber        String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED
  durationSeconds Int?
  recordingUrl    String?
  transcript      String?
  summary         String?
  leadId          String?
  callSid         String    @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, startedAt])
}

// ─────────────────────────────────────────────
// Calendar — Appointments + Blocked Time
// ─────────────────────────────────────────────

model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  // Linked entity — at most one of lead/client/proposal (enforced in the action).
  leadId         String?
  clientId       String?
  proposalId     String?
  // Who created it — drives the sales-rep calendar scope ("mine or staffed-on-me").
  // Nullable: appointments predating this column have no known creator.
  createdById    String?
  title          String
  status         String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELED | NO_SHOW
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?                   @relation(fields: [leadId], references: [id])
  client       Client?                 @relation(fields: [clientId], references: [id])
  proposal     Proposal?               @relation(fields: [proposalId], references: [id])
  createdBy    User?                   @relation("AppointmentCreator", fields: [createdById], references: [id])
  assignments  AppointmentAssignment[]
  planVisit    ServicePlanVisit?
  report       VisitReport?
  booking      Booking?

  @@index([organizationId, startsAt])
}

// Staff (sales / installers — any WorkerProfile) attached to an appointment.
// Mirrors JobAssignment but without the accept/decline lifecycle: appointment
// staffing is informational, so there is no status column.
model AppointmentAssignment {
  id            String   @id @default(cuid())
  appointmentId String
  workerId      String
  createdAt     DateTime @default(now())

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, workerId])
}

model BlockedTime {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String? // user it belongs to (vacation, etc); null = whole-org block
  reason         String   @default("Blocked")
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@index([organizationId, startsAt])
}

// Recurring weekly unavailability ("every Saturday morning"). One row per
// weekly pattern; minutes-from-midnight bounds keep it timezone-simple and
// SQLite-friendly. Owned by a User (same domain as BlockedTime.ownerId) so it
// covers owners/managers as well as invited workers.
model UnavailabilityRule {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  dayOfWeek      Int // 0 = Sunday … 6 = Saturday
  startMinute    Int // minutes from local midnight, 0–1440
  endMinute      Int
  reason         String   @default("Unavailable")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exceptions   UnavailabilityException[]

  @@index([organizationId, ownerId])
}

// Per-instance override of a recurring rule. `freed = true` means "this
// specific date is open even though the rule blocks it" — the rest of the
// series stays blocked.
model UnavailabilityException {
  id     String   @id @default(cuid())
  ruleId String
  date   DateTime // local midnight of the overridden occurrence
  freed  Boolean  @default(true)

  rule UnavailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
}

// ─────────────────────────────────────────────
// Projects (multi-job grouping)
// ─────────────────────────────────────────────

model Project {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  startsAt        DateTime?
  endsAt          DateTime?
  budget          Float     @default(0)
  // The client the project is for (owner, 2026-09-18: "move the client to
  // the project … keep all his proposals under the same project"). Optional:
  // projects made before this, and multi-client builds, carry none.
  clientId        String?
  // REMODEL (every project made before 2026-11-07) or NEW_BUILD — the plan "Projects: Remodel and New construction"
  // (lib/projectKind): the templates, the questions at the start and, as the plan ships, the gates and the money.
  kind            String    @default("REMODEL")
  // The questions asked when the project is made, as JSON (lib/projectKind parseAnswers): the client lives there
  // during a remodel; the template the stages came from.
  answersJson     String?
  // The project's own number, counted per company from 1001 ("#1042") — the stages build (2026-11-05).
  // Null on a project made before then until the one-time numbering (prisma/sql/prod-2026-11-05-project-stages.sql).
  number          Int?
  // Set when the AI drafted the stages from the proposal lines and nobody has kept or edited them yet; the
  // card shows "Drafted by AI" with Keep until then (lib/projectStages).
  stagesDraftedAt DateTime?
  // THE FINISH LINE (the timeline build, 2026-11-06): the client's sign-off (who, when), the warranty's last day,
  // and the day the office called the project finished (status COMPLETED). Each a step on the project's Finish
  // line card; the review ask and the final payment are read from the proposals (lib/projectFinish).
  signedOffAt     DateTime?
  signedOffBy     String?
  warrantyUntil   DateTime?
  finishedAt      DateTime?
  // WHO IT IS FOR, AND THE MONEY (2026-11-07, the plan "Projects: Remodel and New construction", part 5,
  // lib/projectMoneyPlan): CLIENT — the client has a budget and the contractor earns a margin or a fee — or SELF, a
  // spec house or the contractor's own home, a cost tracker with no margin. moneyMode: PROJECT_MARGIN | JOB_MARGIN |
  // COST_PLUS | NONE; marginPct the margin (or the cost-plus fee) in percent; feeAmount a fixed cost-plus fee;
  // salePrice a spec house's, which its profit shows against. Every project made before this: for a client, no mode.
  forWhom         String    @default("CLIENT")
  moneyMode       String    @default("NONE")
  marginPct       Float?
  feeAmount       Float?
  salePrice       Float?
  // THE LOT (2026-11-07, the plan "Projects: Remodel and New construction", part 4): a new build's parcel record
  // (number, zoning, setbacks, acreage, flood zone), the utilities at the street and the permits with their numbers
  // and expiry, as JSON (lib/projectPhases parseLot). Null on a remodel.
  lotJson         String?
  // THE CLIENT'S PAGE (the client build, 2026-11-06): the homeowner's link key (/p/<token>, made the first time the
  // office shares the project), when it was first shared, and when the last update went to them (lib/projectClient).
  publicToken     String?   @unique
  sharedAt        DateTime?
  updateSentAt    DateTime?
  // THE LENDER'S PAGE (2026-11-08, the plan "Projects: Remodel and New construction", part 7, lib/projectClient): a
  // read-only link key (/l/<token>) with the draws and their bundles, the inspections and the photos the office chose;
  // made from the Payments card's Draws. Null until then.
  lenderToken     String?   @unique
  lenderSharedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  jobs         Job[]
  proposals    Proposal[]
  budgetLines  ProjectBudgetLine[]
  expenses     ProjectExpense[]
  stages       ProjectStage[]
  tasks        ProjectTask[]
  materials    ProjectMaterial[]
  orders       ProjectOrder[]
  flags        JobFlag[]
  inspections  ProjectInspection[]
  punchItems   PunchItem[]
  files        ProjectFile[]
  subQuotes    ProjectSubQuote[]
  subRequests  SubRequest[]
  subDocuments SubDocument[]
  selections   ProjectSelection[]
  phases       ProjectPhase[]
  draws        ProjectDraw[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([clientId])
}

// A STAGE OF A PROJECT (the stages build, 2026-11-05) — "Footings", "Framing", "Decking and railings": the
// remodel's order of work, from a trade template (lib/projectStages/templates) or drafted by the AI from the
// proposal lines. % done = the done stages' weight over all stages' weight (an active stage counts its ticked
// tasks' share), so framing counts more than cleanup. Dates are DAYS (UTC midnight, like Project.startsAt).
// Status: PLANNED | ACTIVE | DONE (lib/prismaEnums StageStatus).
model ProjectStage {
  id        String    @id @default(cuid())
  projectId String
  name      String
  position  Int       @default(0)
  status    String    @default("PLANNED")
  startsAt  DateTime?
  endsAt    DateTime?
  doneAt    DateTime?
  doneById  String?
  // The stage's share of the work (its cost share from the template; 1 for a hand-added stage).
  weight    Float     @default(1)
  // NEW CONSTRUCTION (2026-11-07, part 4): the phase the stage belongs to, the lane it is drawn in on the Timeline
  // (null = the house; "Site", "Shop" run beside it), and the stage it cannot start before — "Shift the rest" moves
  // only what depends on the slipped stage (lib/projectTimeline shiftPlan). All null on a remodel's stages.
  phaseId   String?
  lane      String?
  afterId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  after       ProjectStage?       @relation("StageAfter", fields: [afterId], references: [id], onDelete: SetNull)
  dependents  ProjectStage[]      @relation("StageAfter")
  tasks       ProjectTask[]
  materials   ProjectMaterial[]
  orders      ProjectOrder[]
  inspections ProjectInspection[]
  subQuotes   ProjectSubQuote[]
  subRequests SubRequest[]
  selections  ProjectSelection[]

  @@index([projectId, position])
  @@index([phaseId])
}

// THE PHASES OF A NEW BUILD (2026-11-07, the plan "Projects: Remodel and New construction", part 4): land →
// design → permits → site work → foundation → framing and dry-in → rough-ins → insulation and drywall → finishes →
// final and keys, plus a Shop lane when there is one (lib/projectPhases). Each groups its stages, carries its share
// of the work and its gate (the county's inspections on its stages, the client's word or the lender's) and the lead
// times it is known for; `budget` and `margin` are part 5's (the money). A remodel has none.
model ProjectPhase {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  // LAND | DESIGN | PERMITS | SITE | FOUNDATION | FRAME | ROUGH | DRYWALL | FINISHES | FINAL | SHOP
  key            String
  name           String
  position       Int      @default(0)
  share          Float    @default(0)
  // INSPECTION | CLIENT | LENDER
  gateKind       String   @default("CLIENT")
  gateWords      String?
  lane           String?
  // The lead times, as JSON [{ what, days }].
  leadsJson      String?
  budget         Float?
  margin         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages   ProjectStage[]
  expenses ProjectExpense[]
  draws    ProjectDraw[]

  @@index([projectId, position])
}

// DRAWS (2026-11-07, the plan "Projects: Remodel and New construction", part 6): a lender's draw on a new build —
// its number and name, the phase whose close releases it (by key, and the row when it exists), its percent of the
// loan and its dollars, PLANNED → REQUESTED → FUNDED with the days and what was funded, the retainage held back until
// the final, and the bundle sent with the request (the inspections passed, the photos, % done, what was spent) as
// JSON (lib/projectDraws). A remodel has none.
model ProjectDraw {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  phaseId        String?
  afterPhase     String?
  number         Int       @default(1)
  name           String
  pct            Float     @default(0)
  amount         Float     @default(0)
  // PLANNED | REQUESTED | FUNDED
  status         String    @default("PLANNED")
  retainagePct   Float     @default(10)
  requestedAt    DateTime?
  fundedAt       DateTime?
  fundedAmount   Float?
  snapshotJson   String?
  note           String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, number])
}

// A TASK INSIDE A STAGE — "Set joists, east side", ticked on the desk or the crew's phone. `photoNeeded`: the
// task wants a photo when it is ticked (the crew's phone asks for it in part 3). Done = doneAt set.
model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  stageId     String
  title       String
  position    Int       @default(0)
  photoNeeded Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, position])
  @@index([projectId])
}

// AN INSPECTION ON A PROJECT (the timeline build, 2026-11-06) — "Rough-in inspection, Tue Nov 12, have ready: the
// permit card, the ladder". On a stage when it belongs to one (drawn on that stage's bar), dated as a DAY (UTC
// midnight), with what to have ready for the inspector. Result: PENDING | PASSED | FAILED, with a note. `isFinal`
// marks the final inspection — the first step of the project's finish line (lib/projectFinish).
model ProjectInspection {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  stageId        String?
  name           String
  // THE GATE (2026-11-07, the plan "Projects: Remodel and New construction", part 3): `kind` is the inspection's
  // key in lib/projectGates (FRAMING, ROUGH_IN, FINAL…; the name is the county's words, editable), null on one typed
  // free; `gate` holds the stage it is on — the stage cannot be marked done until this passes (the card, the crew's
  // page and the Operator all refuse). Templates add their inspections as gates; the office can turn one off.
  kind           String?
  gate           Boolean   @default(false)
  date           DateTime?
  readyNote      String?
  isFinal        Boolean   @default(false)
  result         String    @default("PENDING")
  resultNote     String?
  resultAt       DateTime?
  resultById     String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([organizationId, date])
}

// A PUNCH-LIST ITEM (the timeline build, 2026-11-06) — "Touch up the paint by the pantry door": the small things
// left at the end, ticked off by the office or by the crew from the job's board, each with an "after" photo when
// one is taken (the JobPhoto, kind AFTER, on the job the item was done from). Done = doneAt set.
model PunchItem {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  jobId          String?
  note           String
  position       Int       @default(0)
  doneAt         DateTime?
  doneById       String?
  photoId        String?   @unique
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job     Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  photo   JobPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@index([jobId])
}

// A FILE ON A PROJECT (the client build, 2026-11-06) — the contract, the permit, the plans, the warranty, an
// invoice: uploaded into the private store (lib/media/privateStore, read through a signed link) or a link to
// where it lives (Google Drive, the county's permit portal). `kind`: CONTRACT | PERMIT | PLAN | WARRANTY |
// INVOICE | OTHER. `clientVisible` puts it on the homeowner's page; the crew sees every file, read-only.
// CONTRACTORS (2026-11-07, the plan "Projects: Remodel and New construction", part 2): the company's subs — the
// list a project asks for quotes from. A contractor is a business contact, never a user.
model Contractor {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  company           String?
  // One of lib/tradeTypes, or the company's own word.
  trade             String?
  phone             String?
  email             String?
  license           String?
  insuranceUntil    DateTime?
  notes             String?
  // THE DIRECTORY (2026-11-08, the subcontractors plan, part 1): the profile the company keeps on a sub — who to
  // talk to, where they are and work, their other trades (JSON string[]), the license's state (by hand now, from
  // the state register in part 3), the insurance's carrier and policy beside its expiry, the bond, the W-9, where
  // the contact came from (MINE | NETWORK | SEARCH), Google's place id when found by search, and a texts opt-out.
  contactName       String?
  website           String?
  address           String?
  serviceAreas      String?
  tradesJson        String?
  // UNKNOWN | ACTIVE | EXPIRED | SUSPENDED | NONE
  licenseStatus     String            @default("UNKNOWN")
  licenseVerifiedAt DateTime?
  licenseSource     String?
  insuranceCarrier  String?
  insurancePolicy   String?
  bondAmount        Float?
  bondUntil         DateTime?
  // NONE | REQUESTED | ON_FILE
  w9Status          String            @default("NONE")
  w9DocumentId      String?
  source            String            @default("MINE")
  placeId           String?
  // Part 3: the state register's last word on this sub (status, specialties, bond, insurance, UBI, principal) and
  // when it was checked — lib/subFinder verifies by hand and nightly.
  registerJson      String?
  registerCheckedAt DateTime?
  textsOptOut       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes            ProjectSubQuote[]
  documents         SubDocument[]

  @@index([organizationId, name])
}

// A quote asked of a contractor for a stage's work, through its award and its invoice (lib/projectSubs). The
// contractor answers on their own page, /q/<publicToken>, with no sign-in: the price and a note, later the invoice.
// Since part 1 of the subcontractors plan (2026-11-08) a row is one RECIPIENT of a SubRequest: it carries the sent,
// viewed and expiry stamps, and every price the sub sends is a SubQuoteVersion (the row's `amount`/`note` mirror the
// current one, so the older readers keep working).
model ProjectSubQuote {
  id                String            @id @default(cuid())
  organizationId    String
  projectId         String
  stageId           String?
  contractorId      String
  number            Int               @default(1)
  scope             String
  // ASKED (sent) | VIEWED | QUOTED | REVISION (a revision asked) | AWARDED | DECLINED | EXPIRED | CANCELLED | INVOICED | PAID
  status            String            @default("ASKED")
  dueBy             DateTime?
  askedAt           DateTime          @default(now())
  amount            Float?
  note              String?
  quotedAt          DateTime?
  awardedAt         DateTime?
  declinedAt        DateTime?
  invoiceAmount     Float?
  invoiceUrl        String?
  invoicedAt        DateTime?
  paidAt            DateTime?
  // The Subcontractors expense "Mark paid" logged on the project.
  expenseId         String?
  publicToken       String            @unique @default(cuid())
  // The request (part 1): the SubRequest this recipient belongs to, the stamps, the versions and the review words.
  requestId         String?
  sentAt            DateTime?
  viewedAt          DateTime?
  expiresAt         DateTime?
  currentVersionId  String?
  approvedVersionId String?
  declineReason     String?
  revisionNote      String?
  // Part 2: the one "reply by tomorrow" reminder the sweep sends (lib/subQuotes/sweep).
  remindedAt        DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage             ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  contractor        Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  request           SubRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  versions          SubQuoteVersion[]
  inboundEmails     InboundEmail[]

  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([requestId])
}

// THE REQUEST FOR QUOTES (2026-11-08, the subcontractors plan, part 1, lib/projectSubs): what the office sends one or
// several subs about a stage's work — a company-wide number ("RFQ-1042"), the trade, the scope, a description,
// materials and labor words, the dates, the deadline, instructions, and the files attached (project Files by id in
// `fileIdsJson`; drawings uploaded for it are SubDocuments with `requestId`). Each sub asked is a ProjectSubQuote.
model SubRequest {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  stageId        String?
  number         Int
  trade          String?
  title          String
  scope          String
  description    String?
  materials      String?
  labor          String?
  fileIdsJson    String?
  startsAt       DateTime?
  endsAt         DateTime?
  dueBy          DateTime?
  instructions   String?
  // Part 2: the AI's two-sentence comparison of the quotes on this request, with the versions it read (lib/subQuotes).
  compareJson    String?
  comparedAt     DateTime?
  // DRAFT | SENT | CLOSED | CANCELLED
  status         String            @default("SENT")
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage          ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  recipients     ProjectSubQuote[]
  documents      SubDocument[]

  @@unique([organizationId, number])
  @@index([projectId, status])
}

// ONE PRICE A SUB SENT (2026-11-08, part 1): a version on its recipient row — the amount, a note, the document it
// came with, where it came from (PORTAL = their page, UPLOAD = the office on their behalf, EMAIL and SMS in part 2),
// the AI's read of the document and its review (part 2), and whether this is the version that was approved. An
// original is never overwritten: a new price is a new version.
model SubQuoteVersion {
  id             String          @id @default(cuid())
  organizationId String
  quoteId        String
  version        Int
  amount         Float?
  note           String?
  documentId     String?
  source         String          @default("PORTAL")
  submittedAt    DateTime        @default(now())
  submittedById  String?
  extractedJson  String?
  extractedAt    DateTime?
  // NONE (nothing to read) | PENDING (a document landed, the read is queued) | READ (the AI's figures wait for a
  // person) | REVIEWED (Use these pressed) | REJECTED (the person said the read is wrong) | FAILED (two tries)
  reviewStatus   String          @default("NONE")
  reviewedById   String?
  reviewedAt     DateTime?
  // Part 2: how many times the reader tried, and the last error's words.
  readAttempts   Int             @default(0)
  readError      String?
  approved       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  quote          ProjectSubQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document       SubDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([quoteId, version])
  @@index([organizationId, submittedAt])
}

// A SUBCONTRACTOR DOCUMENT (2026-11-08, part 1, lib/subDocs): an estimate, later an invoice, a contract, a lien
// waiver, an insurance certificate, a W-9, a drawing attached to a request — in the private store, read through a
// signed link or the sub's token, never a permanent URL. `sha256` finds the same file sent twice; `scanStatus` is
// the malware scan's word once a scanner exists (PENDING | CLEAN | FLAGGED | SKIPPED).
model SubDocument {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String?
  contractorId   String?
  requestId      String?
  // Part 2: the email it arrived in, when it came by email.
  inboundEmailId String?
  // QUOTE | INVOICE | CONTRACT | WAIVER | INSURANCE | W9 | PLAN | OTHER
  kind           String            @default("QUOTE")
  name           String
  url            String
  contentType    String?
  bytes          Int?
  sha256         String?
  scanStatus     String            @default("SKIPPED")
  // OFFICE | SUB | EMAIL
  uploadedVia    String            @default("OFFICE")
  uploadedById   String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor     Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  request        SubRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  inboundEmail   InboundEmail?     @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)
  versions       SubQuoteVersion[]

  @@index([organizationId, createdAt])
  @@index([projectId, kind])
  @@index([requestId])
  @@index([inboundEmailId])
}

// AN EMAIL THAT CAME IN (2026-11-08, the subcontractors plan, part 2, lib/subInbound): a sub's reply to a request,
// delivered by Resend Inbound to rfq-<token>@<the inbound domain>. The token in the address names the recipient row;
// a letter with no token, a closed request, or a stranger's address is held for review (state REVIEW) and matched by
// hand or ignored. The provider's id makes a redelivery a no-op; the raw message is kept in the private store; the
// attachments are SubDocuments that point back here; the version it became, when it did, is `versionId`.
model InboundEmail {
  id             String           @id @default(cuid())
  organizationId String?
  providerId     String           @unique
  fromAddr       String
  toJson         String
  subject        String?
  messageId      String?
  text           String?
  rawUrl         String?
  receivedAt     DateTime
  quoteId        String?
  requestId      String?
  versionId      String?
  // MATCHED | REVIEW | IGNORED
  state          String           @default("REVIEW")
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          ProjectSubQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  documents      SubDocument[]

  @@index([organizationId, state, receivedAt])
  @@index([quoteId])
}

// SELECTIONS (2026-11-07, the plan "Projects: Remodel and New construction", part 3): what the client has to choose
// — cabinets, counters, tile, fixtures, flooring, paint — each with the stage that needs it and a lead time, so its
// due day reads from the stage's first day the way a material's order-by day does (lib/projectSelections); an
// allowance (the money set aside), and once chosen what was picked, from whom and at what price. A choice not made by
// its day flags the project the way a late order does. Templates seed the usual ones; the office adds its own.
model ProjectSelection {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  // The stage that needs the choice made (its first day less leadDays = the due day); null = the project as a whole.
  stageId        String?
  name           String
  // Days before the stage starts that the choice must be in (the lead time to order and receive it).
  leadDays       Int       @default(14)
  // A due day set by hand wins over the one read from the stage.
  dueBy          DateTime?
  // The money set aside for it; null = not set (the card suggests the proposal's matching material lines).
  allowance      Float?
  // What was chosen, from whom, at what price — chosenAt set when the choice is in.
  chosen         String?
  vendor         String?
  price          Float?
  chosenAt       DateTime?
  chosenById     String?
  note           String?
  position       Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@index([organizationId])
}

model ProjectFile {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  kind           String   @default("OTHER")
  url            String
  contentType    String?
  bytes          Int?
  isLink         Boolean  @default(false)
  clientVisible  Boolean  @default(false)
  uploadedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// WHAT A PROJECT HAS TO BUY (the buying build, 2026-11-05) — one line per material the project needs: from a sold
// proposal's lines (lineItemId), an approved change order (changeOrderId), the Deck Studio takeoff, or typed by
// hand. Bought in parts: `orderedQty` is what orders cover, `receivedQty` what arrived (lib/projectBuying).
model ProjectMaterial {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  // The stage it is needed for — the order-by date comes from the stage's first day.
  stageId        String?
  proposalId     String?
  lineItemId     String?
  changeOrderId  String?
  name           String
  quantity       Float    @default(1)
  unit           String   @default("each")
  // What it should cost, each (the estimate's material cost when it has one).
  unitCost       Float?
  // PROPOSAL | CHANGE_ORDER | TAKEOFF | HAND
  source         String   @default("HAND")
  store          String?
  productUrl     String?
  orderedQty     Float    @default(0)
  receivedQty    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ProjectStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  lines   ProjectOrderLine[]

  @@index([projectId])
  @@index([stageId])
}

// AN ORDER ON A PROJECT — part of the to-buy list bought one way: a SUPPLIER (the purchase order is emailed),
// a BUYER (anyone, by a link, no login — the crew, the office, a helper), or STOCK (from the warehouse, in at
// once). It is the delivery too: ORDERED → SHIPPED → DELIVERED, or PARTIAL when something was missing (those
// lines go back on the list), or CANCELED. `number` counts per project (#1042 · order 3).
model ProjectOrder {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  number         Int       @default(1)
  how            String    @default("SUPPLIER")
  status         String    @default("ORDERED")
  stageId        String?
  supplierId     String?
  buyerName      String?
  buyerEmail     String?
  buyerPhone     String?
  // The crew member asked to buy it, when the buyer is one (their crew texts carry the link).
  buyerWorkerId  String?
  publicToken    String    @unique @default(cuid())
  // The day it must be ordered by (the stage's first day less the lead time), and when it is expected.
  orderBy        DateTime?
  expectedAt     DateTime?
  orderedAt      DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  carrier        String?
  trackingNumber String?
  note           String?
  // What it was quoted at, and what was paid (the buyer's figure, or the invoice); the expense logged for it.
  quotedTotal    Float?
  paidTotal      Float?
  expenseId      String?
  // The buyer's own note from the link, and when they last touched it.
  buyerNote      String?
  buyerSeenAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    ProjectStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  supplier Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines    ProjectOrderLine[]

  @@index([projectId])
  @@index([organizationId, status])
  @@index([organizationId, expectedAt])
}

// ONE LINE OF AN ORDER: so much of one material. OPEN until it is bought or arrives; BOUGHT (the buyer ticked it);
// RECEIVED (in full); MISSING (short or damaged — the shortfall goes back on the to-buy list).
model ProjectOrderLine {
  id          String   @id @default(cuid())
  orderId     String
  materialId  String
  quantity    Float
  receivedQty Float    @default(0)
  status      String   @default("OPEN")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order    ProjectOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material ProjectMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([materialId])
}

// HOURS A CREW MEMBER WORKED on a job on a day (the crew build, 2026-11-05) — typed when they close the day (or by
// the office). `rate` is the worker's hourly rate the day it was typed, so a later raise never re-prices old days;
// hours × rate is Labor on the job and the project (lib/jobCost). One row per worker, job and day.
model CrewHours {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String
  workerId       String
  workDayId      String?
  // "2026-11-06" in the company's timezone, like WorkDay.date.
  date           String
  hours          Float
  rate           Float?
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId, date])
  @@index([organizationId, date])
  @@index([workerId, date])
}

// A PROBLEM FLAGGED FROM THE FIELD (the crew build, 2026-11-05) — "the subfloor is rotten", "no power on site":
// a note, whether the crew can keep working, and the job it is on (and its project). The office is texted at
// once; the project reads red until the office resolves it with a word on what was done.
model JobFlag {
  id             String    @id @default(cuid())
  organizationId String
  jobId          String
  projectId      String?
  workerId       String?
  raisedById     String?
  note           String
  blocking       Boolean   @default(false)
  // OPEN | RESOLVED
  status         String    @default("OPEN")
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([jobId])
  @@index([projectId])
}

// A project's cost budget, one line per category (MATERIALS, LABOR,
// SUBCONTRACTORS, PERMITS, EQUIPMENT, OTHER) or a named line under one.
// Project.budget stays the total the list pages read; the budget actions keep
// it equal to the sum of these lines.
model ProjectBudgetLine {
  id        String   @id @default(cuid())
  projectId String
  category  String
  label     String?
  amount    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// A cost logged straight to a project (a permit, a dumpster, a sub's invoice)
// rather than to one of its jobs. Spent-to-date on the budget is these plus
// the JobExpense rows of the project's jobs.
model ProjectExpense {
  id          String    @id @default(cuid())
  projectId   String
  category    String
  amount      Float
  vendor      String?
  note        String?
  spentAt     DateTime  @default(now())
  // A sub's bill (category SUBCONTRACTORS, the crew build 2026-11-05): when it was paid; null = still owed to them.
  paidAt      DateTime?
  // The phase the cost belongs to (part 5, 2026-11-07): set from the order's or the quote's stage, or picked when the
  // cost is logged by hand; null = on no phase (the project's Money card counts it as loose).
  phaseId     String?
  createdById String?
  createdAt   DateTime  @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, spentAt])
  @@index([phaseId])
}

// ─────────────────────────────────────────────
// Applicants (hiring)
// ─────────────────────────────────────────────

model Applicant {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  email          String
  phone          String?
  role           String
  status         String   @default("APPLIED") // APPLIED | INTERVIEWING | HIRED | REJECTED
  source         String?
  notes          String?
  resumeUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ─────────────────────────────────────────────
// Influencer / affiliate
// ─────────────────────────────────────────────

model InfluencerPayout {
  id             String    @id @default(cuid())
  organizationId String
  influencerName String
  amount         Float
  status         String    @default("PENDING") // PENDING | PAID | FAILED
  period         String
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// DEPRECATED (kept read-only for the legacy /dashboard/trade view): these are
// org-scoped, name-keyed and carry no Stripe attribution. The platform-scoped
// Influencer/PromoCode/Attribution/CommissionLedger models below supersede them.
model InfluencerStatement {
  id             String   @id @default(cuid())
  organizationId String
  influencerName String
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  earnings       Float    @default(0)
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
}

// ─────────────────────────────────────────────
// Admin console — Stripe-truth influencer / promo / commission / payouts.
// Money is integer cents. Stripe is the source of truth; these tables cache it
// and are fully rebuildable from Stripe via webhooks + reconciliation.
// ─────────────────────────────────────────────

// A platform influencer/affiliate. Optionally linked to a User login; otherwise
// authenticates via its own credentials (separate influencer login surface).
model Influencer {
  id               String   @id @default(cuid())
  userId           String?  @unique
  email            String   @unique
  displayName      String
  hashedPassword   String? // set when the influencer logs in via the separate surface
  sessionVersion   Int      @default(0) // bumped on every password change; a JWT issued before the bump is refused (lib/orgContext.requireInfluencer)
  status           String   @default("PENDING") // InfluencerStatus
  connectAccountId String?  @unique // Stripe Connect acct_...
  connectStatus    String   @default("NONE") // ConnectStatus (mirror of account state)
  payoutsEnabled   Boolean  @default(false) // mirror of account.payouts_enabled
  defaultCurrency  String   @default("usd")
  minPayoutCents   Int      @default(2500) // payout request threshold
  holdDays         Int      @default(30) // escrow window before commission clears
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoCodes     PromoCode[]
  attributions   Attribution[]
  ledgerEntries  CommissionLedger[]
  payoutRequests PayoutRequest[]
  transfers      PayoutTransfer[]

  @@index([status])
  @@index([connectAccountId])
}

// A Stripe coupon/promotion code owned by an influencer, plus OUR per-code
// commission rule (Stripe knows the customer discount; the payout rate is ours).
model PromoCode {
  id                    String   @id @default(cuid())
  influencerId          String
  stripeCouponId        String // coupon_...
  stripePromotionCodeId String   @unique // promo_...
  code                  String   @unique // redeemable string, e.g. JAMIE20
  active                Boolean  @default(true)
  commissionType        String // CommissionType: PERCENT | FLAT
  commissionRateBps     Int? // basis points when PERCENT (2000 = 20%)
  commissionFlatCents   Int? // flat cents when FLAT
  commissionBasis       String   @default("NET") // CommissionBasis
  durationType          String   @default("REPEATING") // PromoDurationType
  durationMonths        Int? // required when REPEATING
  customerPercentOff    Int? // display mirror of the Stripe coupon percent_off
  clicks                Int      @default(0) // promo-link landing visits (lightweight, no PII)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  influencer          Influencer     @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attributions        Attribution[]
  signupOrganizations Organization[] @relation("OrgSignupPromo")

  @@index([influencerId])
  @@index([stripeCouponId])
}

// One row per Stripe subscription that ever carried a qualifying discount.
// Created ONLY from a Stripe-issued object (subscription/invoice), never from
// pre-checkout frontend intent — abandoned checkouts produce no attribution.
model Attribution {
  id                   String    @id @default(cuid())
  influencerId         String
  promoCodeId          String
  organizationId       String? // resolved via the Subscription mirror
  stripeCustomerId     String // cus_...
  stripeSubscriptionId String    @unique // sub_... — one attribution per subscription
  status               String    @default("ACTIVE") // AttributionStatus
  firstPaidInvoiceAt   DateTime?
  qualifyingMonths     Int       @default(0) // accrual counter for ONCE/REPEATING caps
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  promoCode     PromoCode          @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
  @@index([stripeCustomerId])
}

// Append-only financial truth. Signed integer cents; balance = SUM(amountCents).
// idempotencyKey @unique is the linchpin against double-accrual across webhook
// retries and reconciliation re-runs.
model CommissionLedger {
  id               String    @id @default(cuid())
  influencerId     String
  attributionId    String? // null for PAID / ADJUSTMENT (span many attributions)
  entryType        String // LedgerEntryType
  amountCents      Int // signed: ACCRUED +, REVERSED/PAID -
  currency         String    @default("usd")
  stripeInvoiceId  String? // in_...
  stripeChargeId   String? // ch_... (refund clawback source)
  stripeEventId    String? // evt_...
  clearsAt         DateTime? // ACCRUED clears after holdDays
  state            String    @default("PENDING") // LedgerEntryState
  payoutTransferId String?
  idempotencyKey   String    @unique // accrue:<invoiceId> / reverse:<chargeId>:<refundId> / pay:<transferId>:<entryId>
  memo             String?
  createdAt        DateTime  @default(now())

  influencer  Influencer      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attribution Attribution?    @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  transfer    PayoutTransfer? @relation(fields: [payoutTransferId], references: [id], onDelete: SetNull)

  @@index([influencerId, state])
  @@index([stripeInvoiceId])
  @@index([attributionId])
}

// Influencer-initiated payout request; snapshots the cleared balance at request
// time. Admin approves, then a cron processes it into a PayoutTransfer.
model PayoutRequest {
  id             String    @id @default(cuid())
  influencerId   String
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("PENDING") // PayoutRequestStatus
  requestedBy    String? // admin userId or null (auto)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  periodLabel    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  influencer Influencer       @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  transfers  PayoutTransfer[]

  @@index([influencerId, status])
}

// A Stripe Connect transfer of cleared commission to an influencer's account.
model PayoutTransfer {
  id                     String    @id @default(cuid())
  influencerId           String
  payoutRequestId        String?
  amountCents            Int
  currency               String    @default("usd")
  status                 String    @default("PENDING") // PayoutTransferStatus
  stripeTransferId       String?   @unique // tr_...
  stripeConnectAccountId String // acct_... destination
  failureReason          String?
  idempotencyKey         String    @unique // passed to stripe.transfers.create
  createdAt              DateTime  @default(now())
  paidAt                 DateTime?

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payoutRequest PayoutRequest?     @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
}

// Idempotency log for inbound Stripe webhooks — eventId @unique drops replays.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("STRIPE") // STRIPE | SQUARE
  eventId     String // evt_... / Square event_id
  type        String
  status      String    @default("RECEIVED") // WebhookEventStatus
  payloadHash String?
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([type, receivedAt])
  @@index([provider, receivedAt])
}

// Stripe Price mirror. At most one active price per (plan, interval). Stripe
// Prices are immutable, so editing a price archives the old and points here.
// entitlements.ts remains the feature-gate source of truth.
model PlanPrice {
  id              String   @id @default(cuid())
  planSlug        String // matches PLAN_TIERS (lowercased)
  interval        String // BillingInterval: MONTH | YEAR
  stripeProductId String // prod_...
  stripePriceId   String   @unique // price_... (active price)
  unitAmountCents Int
  currency        String   @default("usd")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  // "At most one active price per (plan, interval)" is enforced in the
  // repoint transaction (archive old → insert new), not by a DB constraint:
  // SQLite has no partial unique index, and many archived rows must coexist.
  @@index([planSlug, interval, active])
}

// Watermarks for the Stripe reconciliation backstop (list cursors per resource).
model SyncState {
  key       String   @id
  cursor    String
  updatedAt DateTime @updatedAt
}

// One row per letter handed to lib/sdk/resend sendEmail (2026-10-21) — sent,
// failed after the retries, or skipped (QA test mode, preview guard, dev
// outbox, no transport) — so "the code never came" can be told apart from
// "the letter left". Written after the response (lib/emailLog), never in the
// way of a send. `to` is lowercased, several addresses joined by ", ". No
// relation to Organization: a deleted company's rows age out with the rest
// (daily-cleanup drops rows older than 90 days). Read by /admin/mail/log,
// /admin/health and the daily-limit alert.
model EmailLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  to             String
  subject        String
  kind           String   @default("other") // lib/emailLog EMAIL_KINDS
  transport      String // smtp | resend | skipped
  status         String // sent | failed | skipped
  providerId     String? // SMTP Message-ID, Resend id, or the skip's marker
  error          String? // the last attempt's error, at most 500 chars
  durationMs     Int      @default(0)
  organizationId String?

  @@index([createdAt])
  @@index([to])
  @@index([kind])
  @@index([status])
}

// What the paid APIs cost us, per organization, per UTC day (2026-10-22) —
// one row per (organization, day, service, op), advanced by an upsert after
// each request that made billed calls (lib/apiSpend, called from
// lib/trialMeter notePaidCall). Every organization, not only trials; QA
// organizations are not written. `day` is the UTC midnight. `cents` is a
// Float: a map tile is half a cent and a static map a fifth, so whole cents
// would round most calls to nothing. No relation to Organization: a deleted
// company's rows age out (daily-cleanup keeps 13 months). Read by
// /admin/usage and the /admin/users account sheet.
model ApiSpendDaily {
  id             String   @id @default(cuid())
  organizationId String
  day            DateTime
  service        String // lib/paidApiCosts PaidService
  op             String
  calls          Int      @default(0)
  cents          Float    @default(0)

  @@unique([organizationId, day, service, op])
  @@index([day])
}

// The in-app guide to a person's first estimate (2026-10-26, owner-approved
// model) — one row per person × organization × tour. `tour` is "first_estimate"
// (the estimator the landing sold: roof / fence / hvac / smart / deck / manual
// in `path`) or "next_steps" (send it, follow-ups, payments). `step` is the
// index of the step the person is on in lib/onboarding/tour-paths; `status` is
// "active" | "paused" | "completed" | "skipped". No relation to User or
// Organization, like ApiSpendDaily: a deleted account's rows are inert.
// Written by actions/onboarding, read by lib/onboarding/progress.
model OnboardingProgress {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tour           String
  path           String
  step           Int       @default(0)
  status         String    @default("active")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  skippedAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, organizationId, tour])
  @@index([organizationId])
}

// Persistent price-lookup cache for the estimator. Keyed on a normalized query
// (see normalizeSearchQuery) + location so a repeated lookup reuses a prior
// fetch when the price source (SerpAPI) is down. productsJson is a JSON-encoded
// product[] string (SQLite-safe / Postgres-portable, matching the schema-wide
// "JSON stored as String" convention). A daily cron prunes stale rows.
model ProductPriceCache {
  id              String   @id @default(cuid())
  normalizedQuery String
  location        String?
  productsJson    String
  source          String?
  currency        String   @default("usd")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([normalizedQuery, location])
  @@index([updatedAt])
}

// ReportAll USA parcel cache. The account quota is ALLTIME (1000 parcels for
// the life of the key), so every fetched parcel is kept forever, keyed on
// ReportAll's stable robust_id. `wkt` is the raw MULTIPOLYGON in EPSG:4326 —
// parsed on read by src/lib/parcels.ts, stored verbatim so nothing is lost.
model ParcelCache {
  robustId      String    @id
  parcelId      String?
  owner         String?
  address       String?
  // Upper-cased, whitespace-collapsed `address` — the key the address lookup
  // matches on. Equality, never `contains`/`mode: insensitive`: SQLite LIKE is
  // case-insensitive while Postgres LIKE is not, and `mode: "insensitive"` does
  // not exist on SQLite, so the only form that behaves identically on the dev
  // and production engines is exact equality over a pre-normalised column.
  addressKey    String?
  city          String?
  zip           String?
  acreage       Float?
  wkt           String
  lat           Float
  lon           Float
  fetchedAt     DateTime  @default(now())
  // The assessor's record (2026-09-16): null on rows cached before the client
  // read these fields; `enrichedAt` says whether a row was ever fetched with
  // them, so a stale row can be refreshed once instead of guessed at.
  bldgSqft      Float?
  yearBuilt     Int?
  storeys       Float?
  buildingCount Int?
  countyName    String?
  stateAbbr     String?
  landUseClass  String?
  buildingsJson String? // JSON array of WKT polygons
  enrichedAt    DateTime?

  @@index([addressKey])
}

// Negative cache: points that returned zero parcels. Key is "lat,lon" rounded
// to 5 decimals (~1.1 m), TTL 7 days — repeated clicks on the same lake do not
// burn the ALLTIME quota, but coverage that appears later is eventually seen.
model ParcelMiss {
  key       String   @id
  checkedAt DateTime @default(now())
}

// One EagleView Property Data ("Instant") order. A row is written THE MOMENT
// EagleView accepts the order — before the first poll — because from that
// moment the lookup is billable whether or not we wait for the result. A poll
// timeout therefore no longer loses the paid result: the requestId is here and
// result/{id} can be asked again later. Also the idempotency ledger: a repeat
// measurement of the same address reuses a complete row or resumes a pending
// one instead of ordering (and paying) again.
/// Which measurement's satellite photo a proposal shows its client — the
/// house on the portal page and the PDF (2026-09-13). Bare ids, no relations,
/// so the table can land on its own; a missing table just means no photo.
model ProposalSitePhoto {
  id                String   @id @default(cuid())
  proposalId        String   @unique
  roofMeasurementId String
  createdAt         DateTime @default(now())
}

/// The organization's own roof catalog for the package builder: its roof
/// types and underlayments with prices, plus the builder's standing
/// preferences (selections and unit prices for everything else). One JSON
/// document per org, written whole by saveRoofCatalog. Like InstantOrder,
/// bare organizationId — no relation — so the table can land on its own.
model RoofCatalog {
  id             String   @id @default(cuid())
  organizationId String   @unique
  catalogJson    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// The organization's fence price book and its own fence types
/// (lib/fence/catalogSchema.ts), one JSON document per org — the same
/// shape as RoofCatalog. Read in try/catch: the fence page prices on the
/// catalog's national rates until the table exists (2026-09-18).
model FenceCatalog {
  id             String   @id @default(cuid())
  organizationId String   @unique
  catalogJson    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Platform-wide Smart Proposal prompt overrides, edited on /admin/prompts
/// (2026-09-18). `key` is one of: master, system, procedure-rules,
/// specialty:<id>:preamble, specialty:<id>:procedure. A missing row means the
/// code default applies; the estimate pipeline reads the table in try/catch
/// so an environment without it prices on the defaults.
model PromptOverride {
  key       String   @id
  body      String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstantOrder {
  id             String   @id @default(cuid())
  organizationId String
  // Upper-cased, whitespace-collapsed "address|city|state|zip" (equality only,
  // same reasoning as ParcelCache.addressKey).
  addressKey     String
  address        String?
  requestId      String   @unique
  // pending | complete | failed
  status         String   @default("pending")
  // The parsed InstantRoofData once retrieved; null while pending/failed.
  instantJson    String?
  // The response body EXACTLY as EagleView sent it, kept because the parser
  // reads 31 paths and drops the rest — every field's confidence, the
  // roof-material polygon, the occlusion classifiers. Two paid lookups were
  // already lost this way and can never be re-examined. One row per paid
  // order, so this is the audit trail of what was actually bought; null for
  // orders placed before 2026-08-28 and for ones that never completed.
  instantRawJson String?
  error          String?
  // JSON array of the Property Data pack ids this order asked for
  // (["property_data_id_001", …]). Since 2026-09-08 an address is bought pack
  // by pack when the account's entitlement is partial, so one address can
  // have several complete rows that together make one answer. Null on rows
  // from before that: those were single seven-pack orders.
  packs          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([addressKey, status])
}

/// Which EagleView Property Data packs the ACCOUNT may order — a fact about
/// the credentials, not about any address, which is why it is not scoped to
/// an organization. `denied` is EagleView's 403 / 10880 ("no active
/// entitlement") on a single-pack order; a 403 costs nothing, so a denied pack
/// is probed again once its record is older than a day. `live` is an accepted
/// order. A pack with no row has never been probed. Reset by
/// scripts/eagleview-recheck-entitlements.ts.
model EagleViewEntitlement {
  // property_data_id_001 … property_data_id_009
  pack      String   @id
  // live | denied
  status    String
  checkedAt DateTime @default(now())
  error     String?
}

/// Google Solar answers for one place, frozen so a second measurement of the
/// same address never depends on Google answering twice.
///
/// NOT organization-scoped, unlike InstantOrder: an Instant lookup is billed to
/// an org and its ledger row is that org's receipt, while Solar imagery is a
/// property of the PLACE. Two orgs measuring the same house should share it.
///
/// The rasters are held as gzipped little-endian float32, the same wire format
/// the QA fixtures use (dsm.f32.gz / mask.f32.gz), about 1.2 MB each.
model SolarCache {
  id         String @id @default(cuid())
  /// Upper-cased, whitespace-collapsed address, or `@lat,lng` rounded to ~1 m
  /// when the caller had only a pin. Same normalisation as the Instant ledger.
  addressKey String @unique
  lat        Float
  lng        Float

  /// DataLayerUrls as returned, minus nothing — the URLs are re-keyed on use.
  layersJson   String
  /// BuildingInsights, when Google answered; its failure is non-fatal upstream.
  insightsJson String?

  /// Raster metadata (width/height/pixelSizeM/originX/originY/epsg) …
  dsmMetaJson  String
  maskMetaJson String
  /// … and the pixels, gzipped float32.
  dsmData      Bytes
  maskData     Bytes

  /// Google's own capture date for this tile, surfaced to the user.
  imageryDate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lat, lng])
}

// ── HVAC estimator (2026-09-15) ───────────────────────────────────────────
// Three tables, none related: the estimator reads them in try/catch and runs
// on defaults until `prisma db push` has created them (same deploy rule as
// RoofCatalog). Every column the engine reads is JSON-as-String, so the
// building model, engine result and priced draft can grow without a schema
// change.

model HvacEstimate {
  id                String   @id @default(cuid())
  organizationId    String
  createdById       String
  address           String
  state             String?
  county            String?
  status            String   @default("draft") // draft | converted
  siteFactsJson     String
  modelJson         String
  engineJson        String
  draftJson         String
  /// The permit-grade Manual J report (Cool Calc), once one is attached.
  approvedReportUrl String?
  /// Cool Calc project/system ids and the report endpoint, JSON (2026-09-15).
  permitJson        String?
  /// What was actually quoted or installed, JSON {tons, price, model, notes} — the calibration loop.
  actualJson        String?
  /// The engine's nominal size when saved (tons × systems), for calibration without parsing engineJson.
  sizedTons         Float?
  /// What was priced (src/lib/hvac/jobs.ts): replace-system, water-heater, …
  jobKind           String?
  proposalId        String?
  subtotal          Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, createdAt])
}

model HvacCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String // stable key from the import (kind-brand-model)
  kind           String
  brand          String
  model          String
  itemJson       String // the CatalogItem, whole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, itemId])
  @@index([organizationId, kind])
}

model HvacSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  rateCardJson   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── WAREHOUSE STOCK (2026-09-20) ─────────────────────────────────────────────
// Owner: the fence, roof and HVAC companies keep their own stock — posts,
// concrete, boards, shingles, underlayment, equipment — and the proposals
// should draw on it: forecast while open, reserved once sold, taken out when
// the crew loads the truck, with a warning before it runs short and a
// purchase order to the supplier. One warehouse per company.

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  website        String?
  notes          String?
  // How many days this supplier takes to deliver — a project's order-by date is the stage's first day less this
  // (the buying build, 2026-11-05); null reads as 3.
  leadDays       Int?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]
  orders       ProjectOrder[]

  @@index([organizationId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  /// "fence" | "roof" | "hvac"
  trade          String
  name           String
  /// The name normalized for matching a proposal line to this item.
  key            String
  unit           String   @default("each")
  onHand         Float    @default(0)
  /// Warn when available stock falls under this; null = the next job's need.
  reorderPoint   Float?
  supplierId     String?
  supplierSku    String?
  lastCost       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements    InventoryMovement[]

  @@unique([organizationId, trade, key])
  @@index([organizationId, trade])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  itemId     String
  /// RECEIVED | PICKED | USED | RETURNED | ADJUST
  kind       String
  /// Signed: received and returned add, picked and used take away.
  quantity   Float
  jobId      String?
  proposalId String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())
  /// The unit price the movement moved at (stage D, 2026-09-30): stamped from
  /// the item's lastCost when stock is issued to a job or returned, so a job's
  /// cost does not drift when the price changes later. Null on older rows —
  /// they read the item's lastCost, else 0 (lib/jobCost).
  unitCost   Float?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([jobId])
}

// ── SERVICE PLANS / MEMBERSHIPS (2026-09-22) ─────────────────────────────────
// A plan template is what the shop sells (visits a year, price, discount,
// benefits); a ServicePlan is one client's membership — a snapshot of the
// terms at signing, its visits, and the invoices that bill it.

model ServicePlanTemplate {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  trade              String   @default("hvac")
  visitsPerYear      Int      @default(2)
  termMonths         Int      @default(12)
  priceCents         Int
  billing            String   @default("MONTHLY") // MONTHLY | YEARLY
  discountPct        Int      @default(0)
  benefitsJson       String   @default("[]")
  priorityScheduling Boolean  @default(true)
  waivedDiagnostic   Boolean  @default(false)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plans        ServicePlan[]

  @@index([organizationId])
}

model ServicePlan {
  id                 String    @id @default(cuid())
  organizationId     String
  templateId         String?
  clientId           String
  status             String    @default("DRAFT") // DRAFT | SENT | ACTIVE | EXPIRED | CANCELED
  name               String
  description        String?
  trade              String    @default("hvac")
  visitsPerYear      Int
  termMonths         Int
  priceCents         Int
  billing            String // MONTHLY | YEARLY
  discountPct        Int       @default(0)
  benefitsJson       String    @default("[]")
  priorityScheduling Boolean   @default(true)
  waivedDiagnostic   Boolean   @default(false)
  propertyAddress    String?
  startsAt           DateTime?
  endsAt             DateTime?
  nextBillingAt      DateTime?
  autoRenew          Boolean   @default(true)
  acceptToken        String    @unique @default(cuid())
  sentAt             DateTime?
  acceptedAt         DateTime?
  acceptedName       String?
  canceledAt         DateTime?
  expiringNoticedAt  DateTime?
  renewedFromId      String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ServicePlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visits       ServicePlanVisit[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([organizationId, endsAt])
  @@index([organizationId, nextBillingAt])
}

model ServicePlanVisit {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  seq            Int
  label          String
  dueAt          DateTime
  status         String    @default("SCHEDULED") // SCHEDULED | DONE | SKIPPED
  appointmentId  String?   @unique
  doneAt         DateTime?
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         ServicePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  report       VisitReport?

  @@index([organizationId, dueAt])
  @@index([planId])
}

// ── EQUIPMENT ON FILE, VISIT REPORTS, ONLINE BOOKING (2026-09-23) ────────────

// What is installed at a client's home: typed, read off a nameplate photo,
// filed by the HVAC estimator on conversion, or noted by the crew on a visit.
model ClientEquipment {
  id                 String    @id @default(cuid())
  organizationId     String
  clientId           String
  kind               String // split-ac-furnace | split-heat-pump | furnace-only | package-unit | ductless | water-heater | boiler | other
  label              String?
  brand              String?
  model              String?
  serial             String?
  tons               Float?
  refrigerant        String?
  fuel               String? // gas | propane | electric | oil
  yearMade           Int?
  installedAt        DateTime?
  warrantyPartsUntil DateTime?
  warrantyLaborUntil DateTime?
  filterSize         String?
  location           String?
  notes              String?
  source             String    @default("typed") // typed | nameplate | estimator | visit
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
}

// The crew's tune-up / visit report: readings, findings, what the client
// should hear — sent by email and readable on a public page.
model VisitReport {
  id              String    @id @default(cuid())
  organizationId  String
  appointmentId   String    @unique
  clientId        String?
  planVisitId     String?   @unique
  techName        String?
  kind            String    @default("both") // cooling | heating | both | other
  readingsJson    String    @default("{}")
  findingsJson    String    @default("[]")
  recommendations String?
  summary         String?
  publicToken     String    @unique @default(cuid())
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  planVisit    ServicePlanVisit? @relation(fields: [planVisitId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// A visit booked online at /book/<slug>: the customer's words, the slot, the
// appointment it became, and the manage link they can move or cancel it with.
model Booking {
  id             String    @id @default(cuid())
  organizationId String
  appointmentId  String?   @unique
  leadId         String?
  clientId       String?
  serviceKey     String
  serviceLabel   String
  minutes        Int
  status         String    @default("BOOKED") // BOOKED | RESCHEDULED | CANCELED | DONE
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  answersJson    String    @default("[]")
  member         Boolean   @default(false)
  manageToken    String    @unique @default(cuid())
  startsAt       DateTime
  endsAt         DateTime
  remindedAt     DateTime?
  canceledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
}

// ─── TEXT MESSAGES (2026-09-24) ─────────────────────────────────────────────
// JobFlex owns the Twilio account; a contractor only adds phone numbers.
// docs/sms.md.

/// An extra office number that gets every office text (the dispatcher, the
/// spouse who runs the books) — beside the members' own verified mobiles.
model NotificationPhone {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A six-digit code on its way to a member's mobile. One live row per user.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every text, out and in: the usage counter, the delivery status from
/// Twilio's callback, the overnight hold (HELD until sendAfter), replies.
model SmsMessage {
  id             String    @id @default(cuid())
  organizationId String?
  direction      String    @default("OUT") // OUT | IN
  to             String
  from           String?
  body           String
  kind           String? // a preference key, "crew-assigned", "crew-digest-today", "verify", "welcome", "reply", …
  status         String    @default("QUEUED") // QUEUED | HELD | SENT | DELIVERED | FAILED | UNDELIVERED | SKIPPED | MERGED | RECEIVED
  sendAfter      DateTime?
  sid            String?   @unique
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, createdAt])
  @@index([to, createdAt])
  @@index([status, sendAfter])
}

/// A number that replied STOP. Twilio blocks it on its side too; this row is
/// what the app checks before every send and shows in Settings.
model SmsOptOut {
  phone     String   @id
  stoppedAt DateTime @default(now())
  body      String?
}

/// A platform-wide integration the admin sets up once for everyone
/// (2026-09-24): `json` is a secretBox-encrypted blob. Key "twilio" holds
/// { accountSid, authToken, messagingServiceSid, fromNumber, enabled }.
/// Env vars remain the fallback when there is no row.
model PlatformIntegration {
  key         String   @id
  json        String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ── TRIAL WATCH (2026-09-24) ──────────────────────────────────────────────
// Who looked at what during a company's first weeks: one row per page a
// signed-in member opens (the route pattern, never the query string), so the
// admin's Trial watch can tell a contractor working from a visitor touring
// the product to copy it. Written fire-and-forget by actions/pageView, which
// also prunes rows older than 120 days; read by actions/trialWatch. No
// relation to Organization on purpose: an unrelated table reaches production
// without touching any table the app already reads.
model PageView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  /// "/dashboard/jobs/*" — ids collapsed, query dropped (lib/trialWatch routePattern).
  route          String
  /// First 16 hex of sha256(client address) and of sha256(user agent): the same device across two trials, no address kept.
  ipHash         String?
  uaHash         String?
  at             DateTime @default(now())

  @@index([organizationId, at])
  @@index([uaHash, ipHash, at])
}

/// Your own texts (2026-09-29): a company's own rule — WHEN something happens
/// (or so many hours before a visit / days after a job), WHO hears it, WHAT it
/// says with {fields} filled from the job. lib/sms/textRules (the catalog,
/// pure) and lib/sms/rulesEngine (the sends). No relation back to anything
/// the app already reads, so the table reaches production on its own.
model TextRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// lib/sms/textRules RuleTriggerKey — "proposal.accepted", "appointment.before", …
  trigger        String
  /// Timed triggers: hours before / days after; null for the moment itself.
  offset         Int?
  toClient       Boolean  @default(false)
  toOffice       Boolean  @default(false)
  toRep          Boolean  @default(false)
  toCrew         Boolean  @default(false)
  /// Named members, a JSON array of user ids.
  toUserIdsJson  String?
  body           String
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, trigger])
}

// ── THE JOBFLEX ASSISTANT (2026-11-04, lib/assistant) ───────────────────────
// A contractor runs JobFlex by talking or texting to it: the app's panel now,
// the "JobFlex Assistant" number next. Questions are answered at once; a
// change is proposed, read back in words the code builds, and waits for YES.

/// A phone allowed to text or call the Assistant number as this person in
/// this company. Proved by a code the person texts FROM that phone — never by
/// User.smsPhone, which a manager can type for someone else. `active` false =
/// paused (STOP to the Assistant pauses this row only, never SmsOptOut).
model AssistantLink {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  phone          String    @unique // E.164
  verifiedAt     DateTime?
  pinHash        String? // the 4-digit PIN for money actions, hashed
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

/// One turn, in or out: the conversation the model reads back, the log, and
/// the monthly `assistantCommands` meter (`countsAsCommand` = a turn the model
/// read; YES / NO / a digit never count). `externalId` = Twilio's MessageSid,
/// so a retried webhook is one turn.
model AssistantMessage {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  channel         String // app | sms | voice
  direction       String // IN | OUT
  body            String
  externalId      String?  @unique
  countsAsCommand Boolean  @default(false)
  actionId        String?
  createdAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

/// A change the Assistant proposed. AWAITING (read back, waiting for YES) →
/// QUEUED (approved; runs at `executeAfter`, the undo window) → RUNNING (claimed
/// by one worker) → DONE | FAILED. NO or UNDO → CANCELED; no answer → EXPIRED.
/// `readback` is the sentence the person approved, built by code from
/// `argsJson`; `resultJson` is what actually happened.
model AssistantAction {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  channel        String
  tool           String
  argsJson       String
  readback       String
  status         String    @default("AWAITING")
  resultJson     String?
  error          String?
  executeAfter   DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId, status])
  @@index([status, executeAfter])
}
